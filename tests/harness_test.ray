@test
fn an_edit_must_name_exactly_one_place() {
    let path = "raycode_edit.tmp";
    let _w = fs.write_file(path, "one\ntwo\nthree\ntwo\n");
    let reg = tools.registry(false);
    // Ninguna vez: casi siempre es que el modelo lo escribió de memoria.
    let missing = tools.execute(
        reg,
        no_servers(),
        "edit_file",
        `{"path":"raycode_edit.tmp","find":"four","replace":"x"}`
    );
    assert(missing.contains("not in"));
    // Varias: no ha dicho cuál, y adivinar es lo único que no se puede hacer.
    let twice = tools.execute(
        reg,
        no_servers(),
        "edit_file",
        `{"path":"raycode_edit.tmp","find":"two","replace":"x"}`
    );
    assert(twice.contains("appears 2 times"));
    // El archivo sigue como estaba tras los dos rechazos.
    assert_eq(fs.read_file(path).unwrap_or(""), "one\ntwo\nthree\ntwo\n");
    // Una: se cambia, y el parche dice dónde cayó.
    let done = tools.execute(reg, no_servers(), "edit_file", `{"path":"raycode_edit.tmp","find":"two
three","replace":"TWO
THREE"}`);
    assert(done.contains("at line 2"));
    assert_eq(fs.read_file(path).unwrap_or(""), "one\nTWO\nTHREE\ntwo\n");
    let _r = fs.remove_file(path);
}

@test
fn an_edit_outside_the_workspace_is_refused() {
    let out = tools.execute(
        tools.registry(false),
        no_servers(),
        "edit_file",
        `{"path":"/etc/hosts","find":"localhost","replace":"nowhere"}`
    );
    assert(out.contains("outside the workspace"));
}

@test
fn search_finds_where_things_are() {
    let reg = tools.registry(false);
    let out = tools.execute(
        reg,
        no_servers(),
        "search",
        `{"query":"pub fn unattended","path":"src"}`
    );
    assert(out.contains("src/permissions.ray:"));
    // Y lo que no está, se dice sin rodeos. (Se busca en `src`: este archivo es parte del
    // árbol, y una búsqueda de algo que solo aparece aquí se encontraría a sí misma.)
    assert(tools
        .execute(reg, no_servers(), "search", `{"query":"qqxzv absent token","path":"src"}`)
        .contains("no match"));
    // Una expresión regular rota se rechaza donde se escribe, no se manda a buscar.
    assert(tools
        .execute(reg, no_servers(), "search", `{"query":"[unclosed","is_regex":true}`)
        .contains("valid regular expression"));
}

@test
fn a_command_says_which_files_it_changed() {
    let before = ["M  src/a.ray", "?? notes.md"];
    let after = ["M  src/a.ray", "M  src/b.ray"];
    let changed = tools.changed_between(before, after);
    // Lo que apareció, y lo que dejó de aparecer: las dos cosas pasaron.
    assert(changed.contains("src/b.ray"));
    assert(changed.contains("notes.md"));
    assert(!changed.contains("src/a.ray"));
    // Un renombrado se cuenta por su destino.
    assert(tools.changed_between([], ["R  old.ray -> new.ray"]).contains("new.ray"));
}

@test
fn a_reading_mode_is_not_given_the_tools_that_change_things() {
    let full = tools.registry(true);
    assert(tools.offers(full, "write_file"));
    let reading = tools.for_mode(full, false);
    assert(tools.offers(reading, "read_file"));
    assert(tools.offers(reading, "search"));
    assert(!tools.offers(reading, "write_file"));
    assert(!tools.offers(reading, "edit_file"));
    assert(!tools.offers(reading, "run_command"));
    // Y un modo que escribe las tiene todas.
    assert_eq(tools.for_mode(full, true).len(), full.len());
    assert(!modes.find("ask").writes);
    assert(!modes.find("plan").writes);
    assert(modes.find("agent").writes);
    assert(modes.find("debug").writes);
    // Lo desconocido se porta como el modo en el que se abre.
    assert(modes.find("sideways").writes);
}

@test
fn the_mode_comes_from_the_flags_and_reaches_the_prompt() {
    match (config.load(["-m", "x", "--mode", "plan"])) {
        Result.Ok(c) => {
            assert_eq(c.mode, "plan");
            assert(config.system_prompt(c).contains("not carrying it out"));
        },
        Result.Err(e) => panic(e),
    }
    match (config.load(["-m", "x", "--mode", "sideways"])) {
        Result.Ok(_) => panic("an unknown mode should not load"),
        Result.Err(e) => assert(e.contains("unknown mode")),
    }
}

@test
fn the_anthropic_body_marks_what_can_be_cached() {
    let c = base_config("anthropic");
    let reg = tools.registry(true);
    let body = anthropic.build_body(c, reg, [message.user("hello")]);
    // El prompt de sistema viaja como LISTA de bloques, no como cadena suelta: es lo que
    // permite marcarlo. (`json.stringify` ordena las claves, así que se mira la forma.)
    assert(body.contains(`"system":[{`));
    assert(body.contains(`"cache_control":{"type":"ephemeral"}`));
    // Dos marcas y no más: el prompt y la última herramienta del catálogo.
    var marks = 0;
    var from = 0;
    var looking = true;
    while (looking) {
        match (body.substring(from, body.len()).index_of("cache_control")) {
            Option.Some(at) => {
                marks = marks + 1;
                from = from + at + 13;
            },
            Option.None => {
                looking = false;
            },
        }
    }
    assert_eq(marks, 2);
    // Sin herramientas, solo la del prompt.
    let bare = anthropic.build_body(c, [], [message.user("hello")]);
    assert(bare.contains("cache_control"));
    assert(!bare.contains("\"tools\""));
}

@test
fn the_responses_api_is_its_own_shape() {
    let c = base_config("responses");
    assert_eq(config.api_name(c.api), "openai-responses");
    assert_eq(config.chat_url(c), "http://localhost:9999/v1/responses");
    let history = [
        message.user("hello"),
        message.assistant(
            "one moment",
            [message.ToolCall { id: "c1", name: "read_file", arguments: `{"path":"x"}` }]
        ),
        message.tool_result("c1", "the file")
    ];
    let body = responses.build_body(c, tools.registry(false), history);
    // El prompt es `instructions`, no un mensaje con rol de sistema.
    assert(body.contains(`"instructions"`));
    assert(!body.contains(`"role":"system"`));
    // El contenido va tipado, y la respuesta de una herramienta es un ítem sin rol.
    assert(body.contains(`"input_text"`));
    assert(body.contains(`"output_text"`));
    assert(body.contains(`"function_call_output"`));
    assert(body.contains(`"call_id":"c1"`));
    // Y una herramienta es plana: nada de envolverla en un objeto `function`.
    assert(body.contains(`"name":"read_file"`));
    assert(!body.contains(`"function":{`));
}

@test
fn a_responses_reply_parses_text_tools_and_usage() {
    let body = `{"model":"gpt-5","status":"completed","output":[{"type":"message","content":[{"type":"output_text","text":"here"}]},{"type":"function_call","call_id":"c9","name":"list_dir","arguments":"{\\"path\\":\\"src\\"}"}],"usage":{"input_tokens":30,"output_tokens":7,"input_tokens_details":{"cached_tokens":20}}}`;
    match (responses.parse_reply(body)) {
        Result.Ok(reply) => {
            assert_eq(reply.message.text, "here");
            assert_eq(reply.message.tool_calls.len(), 1);
            assert_eq(reply.message.tool_calls[0].id, "c9");
            assert_eq(reply.message.tool_calls[0].name, "list_dir");
            assert_eq(reply.usage.input_tokens, 30);
            assert_eq(reply.usage.cached_tokens, 20);
            assert_eq(reply.model, "gpt-5");
        },
        Result.Err(e) => panic(e),
    }
    // Una respuesta cortada por el tope se dice como tal.
    match (responses.parse_reply(
        `{"status":"incomplete","incomplete_details":{"reason":"max_output_tokens"},"output":[]}`
    )) {
        Result.Ok(reply) => assert(message.was_truncated(reply.stop_reason)),
        Result.Err(e) => panic(e),
    }
    // Y un error que llega con 200 se detecta por el campo.
    match (responses.parse_reply(`{"error":{"message":"no such model"}}`)) {
        Result.Ok(_) => panic("an error body should not parse as a reply"),
        Result.Err(e) => assert(e.contains("no such model")),
    }
}

@test
fn a_responses_stream_assembles_the_same_reply() {
    let a = responses.assembly();
    // El texto llega por trozos...
    assert_eq(responses.absorb(a, `{"type":"response.output_text.delta","delta":"he"}`), "he");
    assert_eq(responses.absorb(a, `{"type":"response.output_text.delta","delta":"re"}`), "re");
    // ...y una llamada se anuncia con su call_id antes de que lleguen sus argumentos.
    let _ = responses.absorb(
        a,
        `{"type":"response.output_item.added","output_index":0,"item":{"type":"function_call","call_id":"c9","name":"list_dir","arguments":""}}`
    );
    let _ = responses.absorb(
        a,
        `{"type":"response.function_call_arguments.delta","output_index":0,"delta":"{\\"path\\""}`
    );
    let _ = responses.absorb(
        a,
        `{"type":"response.function_call_arguments.delta","output_index":0,"delta":":\\"src\\"}"}`
    );
    let _ = responses.absorb(
        a,
        `{"type":"response.completed","response":{"model":"gpt-5","usage":{"input_tokens":30,"output_tokens":7}}}`
    );
    let reply = responses.assembled(a);
    assert_eq(reply.message.text, "here");
    assert_eq(reply.message.tool_calls.len(), 1);
    assert_eq(reply.message.tool_calls[0].id, "c9");
    assert_eq(reply.message.tool_calls[0].arguments, `{"path":"src"}`);
    assert_eq(reply.usage.output_tokens, 7);
    assert_eq(reply.model, "gpt-5");
}

@test
fn the_output_ceiling_goes_under_the_name_the_endpoint_wants() {
    // Un servidor compatible cualquiera: el nombre de toda la vida.
    let local = base_config("llama");
    assert_eq(local.max_tokens_field, config.MAX_TOKENS);
    assert(openai.build_body(local, [], [message.user("hi")]).contains(`"max_tokens"`));
    // OpenAI mismo: el nombre que quieren sus modelos nuevos. Se decide con la URL final,
    // no con el perfil.
    match (config.load(["-p", "openai", "-m", "gpt-5"])) {
        Result.Ok(c) => {
            assert_eq(c.max_tokens_field, config.MAX_COMPLETION_TOKENS);
            let body = openai.build_body(c, [], [message.user("hi")]);
            assert(body.contains(`"max_completion_tokens"`));
            assert(!body.contains(`"max_tokens"`));
        },
        Result.Err(e) => panic(e),
    }
}

@test
fn a_provider_error_is_told_in_words() {
    // El mensaje del proveedor dice más que cualquier suposición, y es lo que se enseña.
    let refused = `{"error":{"message":"Incorrect API key provided: sk-xxx"}}`;
    assert(client
        .explain_status(401, refused, "https://api.openai.com/v1/chat/completions", "gpt-5")
        .starts_with("the key was refused: Incorrect API key"));
    // Sin mensaje, se dice qué mirar.
    assert(client.explain_status(403, "", "https://x.test", "").contains("/key"));
    // Un 404 en un chat casi nunca es la URL: es el modelo, y se le nombra.
    let missing = client.explain_status(
        404,
        "",
        "https://api.openai.com/v1/chat/completions",
        "gpt-9"
    );
    assert(missing.contains("'gpt-9'"));
    assert(missing.contains("-p responses"));
    // Las dos formas en que los protocolos envuelven un error, y la que no es ninguna.
    assert_eq(client.error_message(`{"error":{"message":"no"}}`), "no");
    assert_eq(client.error_message(`{"error":"flat"}`), "flat");
    assert_eq(client.error_message("not json at all"), "");
    // Lo que se va a reintentar conserva el prefijo por el que se reconoce.
    assert(client.is_retryable(429));
    assert(client.is_retryable(503));
    assert(!client.is_retryable(400));
    assert(client.is_transient("HTTP 429 from x: slow down"));
    assert(!client.is_transient("the key was refused: nope"));
}

@test
fn an_explained_error_still_carries_what_fixes_the_request() {
    // El error ya no lleva el JSON crudo, y la corrección de parámetros lo sigue leyendo:
    // si esto se rompiera, cada petición volvería a pagar el 400 para siempre.
    var c = base_config("openai");
    c.max_tokens_field = config.MAX_TOKENS;
    let explained = client.explain_status(
        400,
        `{"error":{"message":"Unsupported parameter: 'max_tokens' is not supported with this model. Use 'max_completion_tokens' instead."}}`,
        "https://api.openai.com/v1/chat/completions",
        "gpt-5"
    );
    assert(!explained.contains(`{"error"`));
    assert(client.adapt_to(c, explained) != "");
    assert_eq(c.max_tokens_field, config.MAX_COMPLETION_TOKENS);
}

@test
fn painting_code_never_changes_it() {
    // La invariante que sostiene todo lo demás: el color no toca el texto. Si lo tocara, un
    // bloque de código en una respuesta dejaría de ser copiable, que es para lo que está.
    let lines = [
        `let s = "hola \\"mundo\\"";   // un comentario`,
        "fn main() { return 42; }",
        "  sin nada que pintar  "
    ];
    let painted = syntax.paint_lines("ray", lines);
    var i = 0;
    while (i < lines.len()) {
        assert_eq(render.plain(painted[i]), lines[i]);
        i = i + 1;
    }
    // Y lo que no es código se devuelve tal cual, sin una sola escape.
    let plain = syntax.paint_lines("text", ["# esto es salida, no un comentario"]);
    assert_eq(plain[0], "# esto es salida, no un comentario");
    // Una cerca sin etiqueta tampoco se pinta: adivinar el lenguaje inventaría significado.
    assert_eq(syntax.paint_lines("", ["# lo mismo"])[0], "# lo mismo");
}

@test
fn a_comment_or_a_string_survives_the_line_break() {
    // El estado cruza de una línea a la siguiente, que es lo que un bloque de código
    // necesita y lo que no se puede hacer pintando línea a línea sin llevarlo a mano.
    let painted = syntax.paint_lines(
        "ray",
        ["let x = 1;   /* abre", "sigue", "cierra */ let y = 2;"]
    );
    // La línea de en medio está ENTERA dentro del comentario: va apagada y sin palabras clave.
    assert(painted[1].contains("sigue"));
    assert(!painted[1].contains("[35m"));
    // Y en la tercera, lo que viene después del cierre vuelve a pintarse.
    assert(painted[2].contains("[35mlet"));
    // Lo mismo para una cadena sin cerrar.
    let open = syntax.paint_lines("ray", [`let s = "abre`, "sigue dentro", `cierra";`]);
    assert(!open[1].contains("[35m"));
}

@test
fn a_patch_is_coloured_by_side() {
    let painted = syntax.paint_lines("diff", ["@@ -1,2 +1,3 @@", "-se va", "+llega", " igual"]);
    assert(painted[0].contains("[36m"));
    assert(painted[1].contains("[31m"));
    assert(painted[2].contains("[32m"));
    assert_eq(painted[3], " igual");
}

@test
fn a_code_block_is_framed_to_its_content() {
    let out = render.markdown_text("```sh\nray fetch\nray build --native\n```\n", 70);
    let lines = out.split("\n");
    // Ni una línea de marco vacía: una cerca casi siempre acaba en salto, y ése salía como
    // un `│` suelto justo antes de cerrar, que se lee como si hubiera algo más.
    for line in lines {
        assert(line.trim() != "│");
    }
    assert_eq(lines.len(), 4);
    // El marco cuadra con el contenido: las dos reglas miden lo mismo —el ancho de la línea
    // más larga más el "│ " que la sangra— y ninguna línea se sale de él. (En columnas
    // VISIBLES, que no es lo mismo que en caracteres: van pintadas.)
    let wide = render.visible_len(lines[0]);
    assert_eq(render.visible_len(lines[lines.len() - 1]), wide);
    assert_eq(wide, render.visible_len(lines[2]));
    for line in lines {
        assert(render.visible_len(line) <= wide);
    }
    assert(lines[0].contains("sh"));
    assert(lines[1].contains("ray fetch"));
    // Y una cerca sin lenguaje no deja el espacio de la etiqueta que no hay.
    let bare = render.markdown_text("```\nraycode 0.3.1\n```\n", 70).split("\n");
    assert_eq(bare.len(), 3);
    assert(!bare[0].contains("┌ "));
    assert_eq(render.visible_len(bare[0]), render.visible_len(bare[2]));
    assert_eq(render.visible_len(bare[0]), render.visible_len(bare[1]));
}

@test
fn a_tool_result_reads_as_one_line() {
    // Una línea corta se enseña tal cual.
    assert_eq(agent.result_summary("wrote 42 bytes to fib.ray"), "wrote 42 bytes to fib.ray");
    // Un bloque dice de qué tamaño fue y por dónde empieza, no sus primeros 400 caracteres.
    let listing = agent.result_summary("a.ray\nb.ray\nc.ray");
    assert(listing.starts_with("3 lines · a.ray"));
    // Un fallo se enseña como lo que es, sin contar líneas.
    assert(agent.result_summary("error: no such file\n  at x").starts_with("error: no such file"));
    assert_eq(agent.result_summary("   "), "(nothing)");
}

@test
fn a_complaint_about_a_parameter_fixes_the_request() {
    var c = base_config("openai");
    c.max_tokens_field = config.MAX_TOKENS;
    // Las palabras exactas con las que OpenAI lo dice.
    let refusal = `HTTP 400: {"error":{"message":"Unsupported parameter: 'max_tokens' is not supported with this model. Use 'max_completion_tokens' instead.","code":"unsupported_parameter"}}`;
    assert(client.adapt_to(c, refusal) != "");
    assert_eq(c.max_tokens_field, config.MAX_COMPLETION_TOKENS);
    // Y solo una vez: el arreglo cambia justo lo que estaba buscando, así que no hay bucle.
    assert_eq(client.adapt_to(c, refusal), "");
    // Al revés, para un servidor más viejo que no conoce el nombre nuevo.
    assert(client.adapt_to(c, "Unsupported parameter: 'max_completion_tokens'") != "");
    assert_eq(c.max_tokens_field, config.MAX_TOKENS);
    // La temperatura de los modelos de razonamiento: se deja de mandar.
    assert(c.temperature >= 0.0);
    assert(
        client.adapt_to(
            c,
            `{"error":{"message":"Unsupported value: 'temperature' does not support 0.2 with this model."}}`
        ) != ""
    );
    assert(c.temperature < 0.0);
    assert(!openai.build_body(c, [], [message.user("hi")]).contains(`"temperature"`));
    // Y una queja que no es sobre un parámetro no toca nada.
    assert_eq(client.adapt_to(c, "HTTP 500 from the provider"), "");
}

@test
fn a_rate_limit_is_waited_out_as_the_provider_asked() {
    var h: Map<string, string> = Map.new();
    h.insert("retry-after", "3");
    // La cabecera manda, con medio segundo de propina.
    assert_eq(client.retry_after_ms(h, ""), 3500);
    // Sin cabecera, lo que diga el cuerpo con sus propias palabras.
    var none: Map<string, string> = Map.new();
    assert_eq(
        client.retry_after_ms(
            none,
            `{"error":{"message":"Rate limit reached. Please try again in 9.882s"}}`
        ),
        10382
    );
    // Sin lo uno ni lo otro, nada: quien llama usa su propia espera creciente.
    assert_eq(client.retry_after_ms(none, "overloaded"), 0);
    // Y una espera de una hora no se duerme: hay un tope.
    var far: Map<string, string> = Map.new();
    far.insert("retry-after", "3600");
    assert_eq(client.retry_after_ms(far, ""), client.MAX_RATE_WAIT_MS);
}

// ---------------------------------------------------------------- permisos

@test
fn the_level_says_what_runs_unattended() {
    // Leer nunca pregunta, en ningún nivel.
    for level in [permissions.ASK, permissions.EDITS, permissions.AUTO] {
        assert(permissions.unattended(level, permissions.READ));
    }
    // Escribir, solo desde "edits"; ejecutar, solo en "auto".
    assert(!permissions.unattended(permissions.ASK, permissions.WRITE));
    assert(permissions.unattended(permissions.EDITS, permissions.WRITE));
    assert(!permissions.unattended(permissions.EDITS, permissions.EXEC));
    assert(permissions.unattended(permissions.AUTO, permissions.EXEC));
    // Un nivel que nadie escribió se lee como el más estricto.
    assert(!permissions.unattended("whatever", permissions.WRITE));
}

@test
fn a_command_is_lent_by_program_and_only_when_it_is_one_command() {
    assert_eq(permissions.program_of("make test"), "make");
    assert_eq(permissions.program_of("/usr/bin/make test"), "make");
    assert_eq(permissions.program_of("FOO=bar make test"), "make");
    // Un igual dentro de una ruta no es una asignación.
    assert_eq(permissions.program_of("./a=b/tool run"), "tool");
    let lent = ["make", "git"];
    assert(permissions.allowed(lent, "make test"));
    assert(permissions.allowed(lent, "git status"));
    assert(!permissions.allowed(lent, "curl http://x.test"));
    // Lo que deja correr algo MÁS se pregunta, por familiar que sea la primera palabra.
    assert(!permissions.allowed(lent, "make test | sh"));
    assert(!permissions.allowed(lent, "make test; curl evil.test"));
    assert(!permissions.allowed(lent, "make test > /etc/passwd"));
    assert(!permissions.allowed(lent, "make $(whoami)"));
}

@test
fn an_mcp_tool_is_only_unattended_when_its_server_says_so() {
    // Lo que el servidor no declara de solo lectura entra como lo más peligroso que hay.
    let reply = `{"tools":[{"name":"peek","description":"look","inputSchema":{"type":"object"},"annotations":{"readOnlyHint":true}},{"name":"poke","description":"change","inputSchema":{"type":"object"}}]}`;
    let parsed = match (json.parse(reply)) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    match (mcp.parse_tools(parsed)) {
        Result.Ok(list) => {
            assert_eq(list.len(), 2);
            assert(list[0].read_only);
            assert(!list[1].read_only);
        },
        Result.Err(e) => panic(e),
    }
}

@test
fn the_autonomy_level_comes_from_the_flags() {
    match (config.load(["-m", "x", "--autonomy", "edits"])) {
        Result.Ok(c) => assert_eq(c.autonomy, permissions.EDITS),
        Result.Err(e) => panic(e),
    }
    // `--allow-exec` es lo que decía: ofrece el shell y corre lo que pida el modelo.
    match (config.load(["-m", "x", "--allow-exec"])) {
        Result.Ok(c) => {
            assert(c.allow_exec);
            assert_eq(c.autonomy, permissions.AUTO);
        },
        Result.Err(e) => panic(e),
    }
    // Salvo que se diga otra cosa a mano, venga antes o después.
    match (config.load(["-m", "x", "--allow-exec", "--autonomy", "ask"])) {
        Result.Ok(c) => assert_eq(c.autonomy, permissions.ASK),
        Result.Err(e) => panic(e),
    }
    match (config.load(["-m", "x", "--autonomy", "ask", "--allow-exec"])) {
        Result.Ok(c) => assert_eq(c.autonomy, permissions.ASK),
        Result.Err(e) => panic(e),
    }
    match (config.load(["-m", "x", "--allow", "make,git"])) {
        Result.Ok(c) => {
            assert(c.allowed_programs.contains("make"));
            assert(c.allowed_programs.contains("git"));
        },
        Result.Err(e) => panic(e),
    }
    match (config.load(["-m", "x", "--autonomy", "sideways"])) {
        Result.Ok(_) => panic("an unknown level should not load"),
        Result.Err(e) => assert(e.contains("unknown autonomy")),
    }
}

// ---------------------------------------------------------------- mcp

@test
fn mcp_names_round_trip() {
    assert_eq(mcp.tool_name("raylang", "ray_check"), "mcp__raylang__ray_check");
    match (mcp.split_name("mcp__raylang__ray_check")) {
        Option.Some(pair) => {
            assert_eq(pair.0, "raylang");
            assert_eq(pair.1, "ray_check");
        },
        Option.None => panic("expected a server and a tool"),
    }
    // El nombre de la herramienta puede llevar '__' a su vez: el corte es el primero.
    match (mcp.split_name("mcp__s__a__b")) {
        Option.Some(pair) => {
            assert_eq(pair.0, "s");
            assert_eq(pair.1, "a__b");
        },
        Option.None => panic("expected a split"),
    }
    assert(!mcp.is_remote("read_file"));
    match (mcp.split_name("mcp__broken")) {
        Option.Some(_) => panic("expected None"),
        Option.None => { },
    }
}

@test
fn mcp_config_follows_the_standard_envelope() {
    let text = `{"mcpServers":{"zeta":{"command":"z","disabled":true},"raylang":{"command":"ray","args":["mcp"],"env":{"RAY_LOG":"1"},"dir":"sub"}}}`;
    match (mcp.parse_config(text)) {
        Result.Err(e) => panic(e),
        Result.Ok(servers) => {
            assert_eq(servers.len(), 2);
            // Ordenados por nombre, para que el catálogo sea estable entre arranques.
            assert_eq(servers[0].name, "raylang");
            assert_eq(servers[0].command, "ray");
            assert_eq(servers[0].args, ["mcp"]);
            assert_eq(servers[0].dir, "sub");
            match (get(servers[0].env, "RAY_LOG")) {
                Option.Some(v) => assert_eq(v, "1"),
                Option.None => panic("expected RAY_LOG in env"),
            }
            assert(servers[0].enabled);
            assert_eq(servers[1].name, "zeta");
            assert(!servers[1].enabled);
            assert_eq(mcp.command_line(servers[0]), "ray mcp");
        },
    }
    match (mcp.parse_config(`{"mcpServers":{"bad__name":{"command":"x"}}}`)) {
        Result.Ok(_) => panic("expected an error"),
        Result.Err(e) => assert(e.contains("bad__name")),
    }
    match (mcp.parse_config(`{"mcpServers":{"x":{"args":["a"]}}}`)) {
        Result.Ok(_) => panic("expected an error"),
        Result.Err(e) => assert(e.contains("command")),
    }
    match (mcp.parse_config(`{"servers":{}}`)) {
        Result.Ok(_) => panic("expected an error"),
        Result.Err(e) => assert(e.contains("mcpServers")),
    }
}

@test
fn mcp_handshake_and_requests_are_json_lines() {
    let lines = mcp.handshake().trim().split("\n");
    assert_eq(lines.len(), 2);
    assert(lines[0].contains("\"method\":\"initialize\""));
    assert(lines[0].contains("\"id\":1"));
    assert(lines[0].contains(mcp.PROTOCOL_VERSION));
    assert(lines[1].contains("notifications/initialized"));
    assert(!lines[1].contains("\"id\""));
    let params = match (json.parse(`{"name":"ray_fmt","arguments":{"code":"fn main() {}"}}`)) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    let line = mcp.request(7, "tools/call", params);
    assert(!line.contains("\n"));
    assert(line.contains("\"id\":7"));
    assert(line.contains("\"name\":\"ray_fmt\""));
}

@test
fn mcp_pick_selects_the_reply_by_id_and_skips_noise() {
    let output = "starting up\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[]}}\n";
    match (mcp.pick(output, 2)) {
        Option.Some(j) => match (json.member(j, "result")) {
            Option.Some(_) => { },
            Option.None => panic("expected a result"),
        },
        Option.None => panic("expected the reply with id 2"),
    }
    match (mcp.pick(output, 7)) {
        Option.Some(_) => panic("expected None"),
        Option.None => { },
    }
}

@test
fn mcp_flatten_joins_text_and_turns_is_error_into_err() {
    let ok = match (json.parse(
        `{"content":[{"type":"text","text":"a"},{"type":"image","data":"AAAA","mimeType":"image/png"},{"type":"text","text":"b"}],"isError":false}`
    )) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    match (mcp.flatten(ok)) {
        Result.Ok(text) => assert_eq(text, "a\n[image 0 KiB]\nb"),
        Result.Err(e) => panic(e),
    }
    let failed = match (json.parse(`{"content":[{"type":"text","text":"boom"}],"isError":true}`)) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    match (mcp.flatten(failed)) {
        Result.Ok(_) => panic("expected an error"),
        Result.Err(e) => assert_eq(e, "boom"),
    }
}

@test
fn mcp_resources_list_and_read_are_parsed() {
    let listed = match (json.parse(
        `{"resources":[{"uri":"x://a","name":"A","description":"about a","mimeType":"text/plain"},{"uri":"x://b"}]}`
    )) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    match (mcp.parse_resources(listed)) {
        Result.Err(e) => panic(e),
        Result.Ok(r) => {
            assert_eq(r.len(), 2);
            assert_eq(r[0].uri, "x://a");
            assert_eq(r[0].name, "A");
            assert_eq(r[0].mime, "text/plain");
            assert_eq(r[1].name, "");
        },
    }
    let read = match (json.parse(
        `{"contents":[{"uri":"x://a","mimeType":"text/plain","text":"hello"},{"uri":"x://b","mimeType":"image/png","blob":"AAAAAAAA"}]}`
    )) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    match (mcp.flatten_contents(read)) {
        Result.Ok(text) => assert_eq(text, "hello\n[blob 0 KiB image/png]"),
        Result.Err(e) => panic(e),
    }
    // Un servidor sin recursos no tiene lista: no es un fallo, es una lista vacía.
    let servers = match (mcp.parse_config(
        `{"mcpServers":{"flaky":{"command":"sh","args":["${flaky_server_script()}"]}}}`
    )) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    let catalogue = tools.from_servers(servers);
    assert_eq(servers[0].resources.len(), 0);
    assert(!tools.offers(catalogue, tools.READ_RESOURCE));
    mcp.shutdown(servers);
}

@test
fn mcp_tools_list_becomes_remote_tools() {
    let result = match (json.parse(
        `{"tools":[{"name":"a","description":"A","inputSchema":{"type":"object","properties":{"x":{"type":"string"}}}},{"name":"b"}]}`
    )) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    };
    match (mcp.parse_tools(result)) {
        Result.Err(e) => panic(e),
        Result.Ok(remote) => {
            assert_eq(remote.len(), 2);
            assert_eq(remote[0].name, "a");
            assert_eq(remote[0].description, "A");
            assert(json.stringify(remote[0].schema).contains("\"x\""));
            assert_eq(remote[1].description, "");
            assert(json.stringify(remote[1].schema).contains("\"type\":\"object\""));
        },
    }
}

@test
fn mcp_remote_tools_enter_the_catalogue_and_dispatch() {
    // De punta a punta contra `ray mcp`; se salta si el binario no está en el PATH.
    match (process.run("ray", ["--version"])) {
        Result.Err(_) => {
            return;
        },
        Result.Ok(_) => { },
    }
    let servers = match (mcp.parse_config(`{"mcpServers":{"raylang":{"command":"ray","args":["mcp"]}}}`)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    let catalogue = tools.from_servers(servers);
    assert(servers[0].enabled);
    assert_eq(servers[0].note, "");
    // `ray mcp` declara instrucciones en `initialize`; llegan al prompt de sistema con etiqueta.
    assert(servers[0].instructions.contains("llms.txt"));
    let block = mcp.instructions_of(servers);
    assert(block.starts_with("Instructions from the MCP server 'raylang'"));
    assert(block.contains("mcp__raylang__"));
    var c = base_config("llama");
    c.mcp_instructions = block;
    assert(config.system_prompt(c).starts_with(c.system));
    assert(config.system_prompt(c).contains("llms.txt"));
    let body = openai.build_body(c, catalogue, [message.user("hi")]);
    assert(body.contains("llms.txt"));
    let anthropic_body = anthropic.build_body(
        base_config("anthropic"),
        catalogue,
        [message.user("hi")]
    );
    assert(!anthropic_body.contains("Instructions from the MCP server"));
    // El catálogo son las herramientas del servidor más `read_resource` para sus recursos.
    assert_eq(servers[0].tool_count + 1, catalogue.len());
    assert(tools.offers(catalogue, "mcp__raylang__ray_check"));
    assert_eq(catalogue[0].source, "raylang");
    let verdict = tools.execute(
        catalogue,
        servers,
        "mcp__raylang__ray_check",
        `{"code":"fn main() { let x: int = \\"a\\"; }"}`
    );
    assert(verdict.contains("type error"));
    let fine = tools.execute(
        catalogue,
        servers,
        "mcp__raylang__ray_check",
        `{"code":"fn main() {}"}`
    );
    assert(fine.contains("ok"));
}

@test
fn mcp_a_server_that_cannot_start_is_marked_not_fatal() {
    let servers = match (mcp.parse_config(`{"mcpServers":{"ghost":{"command":"/nonexistent/mcp-server"}}}`)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    let catalogue = tools.from_servers(servers);
    assert_eq(catalogue.len(), 0);
    assert(!servers[0].enabled);
    assert(servers[0].note.contains("cannot start"));
    let answer = tools.execute(catalogue, servers, "mcp__ghost__x", "{}");
    assert(answer.contains("unknown tool"));
    assert(!servers[0].running);
}

// Un servidor de mentira en sh: contesta initialize y tools/list con la id que le llega,
// y se MUERE al primer tools/call. Sirve para probar el relanzamiento.
fn flaky_server_script() -> string {
    let path = "/tmp/raycode_flaky_mcp.sh";
    let script = `while read line; do
  id=$(printf '%s' "$line" | sed -n 's/.*"id":\\([0-9]*\\).*/\\1/p')
  case "$line" in
    *initialize*) echo "{\\"jsonrpc\\":\\"2.0\\",\\"id\\":$id,\\"result\\":{\\"instructions\\":\\"be brief\\"}}" ;;
    *tools/list*) echo "{\\"jsonrpc\\":\\"2.0\\",\\"id\\":$id,\\"result\\":{\\"tools\\":[{\\"name\\":\\"boom\\"}]}}" ;;
    *tools/call*) exit 3 ;;
  esac
done
`;
    match (fs.write_file(path, script)) {
        Result.Ok(_) => path,
        Result.Err(e) => panic(e),
    }
}

@test
fn mcp_a_server_that_dies_mid_session_is_reported_and_relaunched() {
    let path = flaky_server_script();
    let servers = match (mcp.parse_config(`{"mcpServers":{"flaky":{"command":"sh","args":["${path}"]}}}`)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    let catalogue = tools.from_servers(servers);
    assert_eq(catalogue.len(), 1);
    assert_eq(servers[0].instructions, "be brief");
    // La llamada mata al servidor: el modelo recibe un error legible, no un cuelgue.
    let first = tools.execute(catalogue, servers, "mcp__flaky__boom", "{}");
    assert(first.contains("exited"));
    assert(first.contains("exit 3"));
    // Y la siguiente petición relanza el proceso: vuelve a contestar como nuevo.
    match (mcp.ask(servers[0], "tools/list", match (json.parse("{}")) {
        Result.Ok(j) => j,
        Result.Err(e) => panic(e),
    }, 3000)) {
        Result.Ok(answer) => assert_eq(answer.instructions, "be brief"),
        Result.Err(e) => panic(e),
    }
    mcp.shutdown(servers);
}

// Un proveedor de mentira que pide un mandato en su primera respuesta y contesta con
// texto en la segunda: lo justo para hacer correr un turno entero.
fn fake_provider(req: webserver.Request) -> webserver.Response {
    let body = match (from_utf8(req.body)) {
        Result.Ok(t) => t,
        Result.Err(_) => "",
    };
    // El segundo viaje lleva ya el resultado de la herramienta en el historial.
    if (body.contains("\"role\":\"tool\"")) {
        return webserver.json_response(
            `{"choices":[{"message":{"role":"assistant","content":"understood"},"finish_reason":"stop"}]}`
        );
    }
    webserver.json_response(
        `{"choices":[{"message":{"role":"assistant","content":"","tool_calls":[{"id":"c1","type":"function","function":{"name":"run_command","arguments":"{\\"command\\":\\"rm -rf /\\"}"}}]},"finish_reason":"tool_calls"}]}`
    )
}

@test
fn a_command_nobody_could_be_asked_about_is_not_run() {
    let port = 18732;
    spawn(fn() {
        match (webserver.serve("127.0.0.1", port, fake_provider)) {
            Result.Ok(_) => { },
            Result.Err(e) => print("fake provider: ${e}"),
        }
    });
    time.sleep(100);
    // `--allow-exec` ofrece la herramienta; `--autonomy ask` dice que se pregunte. Y la
    // suite no tiene terminal, así que no hay a quién preguntar.
    let c = match (config.load(
        [
            "-p",
            "openai",
            "-m",
            "test-model",
            "-u",
            "http://127.0.0.1:${port}",
            "--no-mcp",
            "--no-stream",
            "--allow-exec",
            "--autonomy",
            "ask"
        ]
    )) {
        Result.Ok(v) => v,
        Result.Err(e) => panic(e),
    };
    let s = match (agent.open(c)) {
        Result.Ok(v) => v,
        Result.Err(e) => panic(e),
    };
    match (agent.ask(s, "clean up")) {
        Result.Ok(_) => { },
        Result.Err(e) => panic(e),
    }
    // La llamada quedó contestada —un tool_use sin resultado invalida el historial— y lo
    // que se contestó es que no se corrió.
    var answered = false;
    for m in s.history {
        if (m.role == "tool" && m.text.contains("not run")) {
            answered = true;
        }
    }
    assert(answered);
    // Y el turno siguió: el modelo llegó a contestar.
    assert_eq(s.history[s.history.len() - 1].text, "understood");
    agent.close(s);
}

// Un servidor MCP por HTTP de mentira, en proceso: sesión por cabecera, `initialize` en
// JSON, `tools/list` como flujo SSE y `tools/call` en JSON, 404 sin la sesión.
fn fake_http_mcp(req: webserver.Request) -> webserver.Response {
    let body = match (from_utf8(req.body)) {
        Result.Ok(t) => t,
        Result.Err(_) => "",
    };
    let id = match (json.parse(body)) {
        Result.Ok(j) => match (json.get_int(j, "id")) {
            Option.Some(n) => n,
            Option.None => 0 - 1,
        },
        Result.Err(_) => 0 - 1,
    };
    if (req.method == "DELETE") {
        return webserver.text(200, "");
    }
    if (body.contains("\"initialize\"")) {
        var r = webserver.json_response(
            `{"jsonrpc":"2.0","id":${id},"result":{"protocolVersion":"2024-11-05","capabilities":{"tools":{}},"serverInfo":{"name":"fake"},"instructions":"over http"}}`
        );
        r.headers.insert("Mcp-Session-Id", "s1");
        return r;
    }
    let session = match (get(req.headers, "mcp-session-id")) {
        Option.Some(v) => v,
        Option.None => "",
    };
    if (session != "s1") {
        return webserver.text(404, "no such session");
    }
    if (body.contains("notifications/initialized")) {
        return webserver.text(202, "");
    }
    if (body.contains("tools/list")) {
        var r = webserver.text(
            200,
            ": keep-alive\n\nevent: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":${id},\"result\":{\"tools\":[{\"name\":\"echo\",\"inputSchema\":{\"type\":\"object\"}}]}}\n\n"
        );
        r.headers.insert("Content-Type", "text/event-stream");
        return r;
    }
    if (body.contains("tools/call")) {
        return webserver.json_response(
            `{"jsonrpc":"2.0","id":${id},"result":{"content":[{"type":"text","text":"echo: ${body.len()} bytes, session ${session}"}]}}`
        );
    }
    webserver.json_response(
        `{"jsonrpc":"2.0","id":${id},"error":{"code":-32601,"message":"method not found"}}`
    )
}

@test
fn mcp_speaks_streamable_http() {
    let port = 18731;
    spawn(fn() {
        match (webserver.serve("127.0.0.1", port, fake_http_mcp)) {
            Result.Ok(_) => { },
            Result.Err(e) => print("fake http mcp: ${e}"),
        }
    });
    time.sleep(100);
    let servers = match (mcp.parse_config(
        `{"mcpServers":{"web":{"type":"http","url":"http://127.0.0.1:${port}/mcp","headers":{"Authorization":"Bearer x"}}}}`
    )) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    assert(mcp.is_http(servers[0]));
    assert_eq(mcp.command_line(servers[0]), "http://127.0.0.1:${port}/mcp");
    let catalogue = tools.from_servers(servers);
    assert_eq(servers[0].note, "");
    assert(servers[0].enabled);
    assert_eq(servers[0].instructions, "over http");
    assert(tools.offers(catalogue, "mcp__web__echo"));
    // La llamada viaja con la sesión que dio el initialize (sin ella el servidor da 404).
    let out = tools.execute(catalogue, servers, "mcp__web__echo", `{"x":1}`);
    assert(out.starts_with("echo:"));
    assert(out.contains("session s1"));
    mcp.shutdown(servers);
    assert(!servers[0].running);
}

@test
fn mcp_http_config_is_validated() {
    match (mcp.parse_config(`{"mcpServers":{"x":{"url":"ftp://nope"}}}`)) {
        Result.Ok(_) => panic("expected an error"),
        Result.Err(e) => assert(e.contains("http://")),
    }
    match (mcp.parse_config(`{"mcpServers":{"x":{"headers":{}}}}`)) {
        Result.Ok(_) => panic("expected an error"),
        Result.Err(e) => assert(e.contains("url")),
    }
    // Un servidor HTTP que no existe se marca y no aporta nada, como uno stdio que no arranca.
    let servers = match (mcp.parse_config(`{"mcpServers":{"down":{"url":"http://127.0.0.1:9/mcp"}}}`)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    assert_eq(tools.from_servers(servers).len(), 0);
    assert(!servers[0].enabled);
    assert(servers[0].note.contains("cannot reach"));
}

@test
fn a_tool_call_reads_as_code_not_as_json() {
    let lines = agent.call_summary(
        "write_file",
        "{\"path\":\"src/theme.ray\",\"content\":\"pub fn css() -> string {\\n    `:root { --bg: 0 0% 100%; }`\\n}\\n\"}"
    );
    assert(lines[0].contains("path: src/theme.ray"));
    // El contenido largo no viaja en la cabecera: baja abajo, ya sin escapar.
    assert(!lines[0].contains("--bg"));
    assert_eq(lines[1], "  content · 3 lines");
    assert(lines[2].ends_with("pub fn css() -> string {"));
    assert(!lines[2].contains("\\n"));
    // Lo que no es un objeto JSON se enseña tal cual.
    let odd = agent.call_summary("weird", "not json");
    assert_eq(odd.len(), 1);
    assert(odd[0].contains("not json"));
}
