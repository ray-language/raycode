// Configuración del harness: perfil de proveedor (llama.cpp local, OpenAI o Anthropic),
// credenciales y parámetros de muestreo. Todo se puede fijar por entorno y sobreescribir
// por bandera de línea de órdenes.

/// The version raycode reports (`--version`, the MCP `clientInfo`). Must match `ray.toml`:
/// the release workflow refuses a tag where the two disagree.
pub const VERSION: string = "0.3.1";

import std/uuid;
import std/keychain;
import src/permissions;
import src/modes;
import src/ui;

/// The wire protocol spoken to the endpoint.
pub enum Api {
    Anthropic,
    OpenAI,
    /// OpenAI's other API, `POST /v1/responses`, where its newer reasoning and code models
    /// are served. Same host and same key as Chat Completions, different shape.
    Responses,
}

/// Everything the harness needs to talk to one model.
pub struct Config {
    api: Api,
    profile: string,
    base_url: string,
    api_key: string,
    model: string,
    system: string,
    max_tokens: int,
    temperature: float,
    timeout_ms: int,
    max_steps: int,
    allow_exec: bool,
    stream: bool,
    verbose: bool,
    prompt: string,
    mcp_enabled: bool,
    mcp_config: string,
    help: bool,
    version: bool,
    mcp_instructions: string,
    /// A stable id for the conversation, sent as `x-opencode-session`; renewed on `/reset`.
    session_id: string,
    /// Extra request headers (`-H "Name: value"`), for proxies that require their own.
    headers: [string],
    /// How much happens without a yes: `permissions.ASK`, `EDITS` or `AUTO`.
    autonomy: string,
    /// What the turn is for, and whether the tools that change things are on the table:
    /// `ask`, `plan`, `agent` or `debug`.
    mode: string,
    /// Where the key came from: "flag", "env", "keychain" or "" when there is none. What is
    /// said about a key is where it came from, never the key.
    key_source: string,
    /// What this endpoint calls the output ceiling in the OpenAI protocol: `max_tokens`,
    /// which is what everyone copied, or `max_completion_tokens`, which is what OpenAI's
    /// newer models insist on and what refusing the old name is about. Guessed from the
    /// host and corrected by the provider itself the first time it complains.
    max_tokens_field: string,
    /// The programs the user has lent the agent — by program, not by command line. Grows
    /// while the session runs, whenever the answer to "run this?" is "always".
    allowed_programs: [string],
    /// Tools lent by name, for everything that is not a shell command (an MCP tool that
    /// changes things, say). Same growth, same lifetime: the session.
    allowed_tools: [string],
}

/// The protocol name, for the banner.
pub fn api_name(a: Api) -> string {
    match (a) {
        Api.Anthropic => "anthropic",
        Api.OpenAI => "openai-compatible",
        Api.Responses => "openai-responses",
    }
}

// El valor de una variable de entorno, o `fallback` si no está o está vacía.
fn env_or(name: string, fallback: string) -> string {
    match (env(name)) {
        Option.Some(v) => if (v.trim() == "") { fallback } else { v },
        Option.None => fallback,
    }
}

// Los programas prestados de antemano: `RAYCODE_ALLOW="make,git"`.
fn allowed_from_env() -> [string] {
    var out: [string] = [];
    for raw in env_or("RAYCODE_ALLOW", "").split(",") {
        let name = raw.trim();
        if (name != "") {
            out.push(name);
        }
    }
    out
}

/// The name everyone copied, and the one OpenAI's newer models want instead.
pub const MAX_TOKENS: string = "max_tokens";

pub const MAX_COMPLETION_TOKENS: string = "max_completion_tokens";

/// Which of the two an endpoint is most likely to take. A guess, and only a first one: the
/// provider corrects it by complaining, and the harness believes the provider.
pub fn token_field_for(base_url: string) -> string {
    if (base_url.contains("api.openai.com")) { MAX_COMPLETION_TOKENS } else { MAX_TOKENS }
}

const DEFAULT_SYSTEM: string = "You are raycode, a concise coding assistant running in a terminal harness. Use the available tools to inspect and edit the workspace before answering. Keep answers short and concrete.";

// Perfil base: define protocolo, endpoint, clave y modelo por defecto. Las banderas
// posteriores lo afinan.
fn preset(profile: string) -> Result<Config, string> {
    let common_max = match (parse_int(env_or("RAYCODE_MAX_TOKENS", "4096"))) {
        Option.Some(n) => n,
        Option.None => 4096,
    };
    let common_timeout = match (parse_int(env_or("RAYCODE_TIMEOUT_MS", "600000"))) {
        Option.Some(n) => n,
        Option.None => 600000,
    };
    let common_steps = match (parse_int(env_or("RAYCODE_MAX_STEPS", "12"))) {
        Option.Some(n) => n,
        Option.None => 12,
    };
    let temperature = match (parse_float(env_or("RAYCODE_TEMPERATURE", "0.2"))) {
        Option.Some(t) => t,
        Option.None => 0.2,
    };
    let base = Config {
        api: Api.OpenAI,
        profile: profile,
        base_url: "",
        api_key: "",
        model: "",
        system: env_or("RAYCODE_SYSTEM", DEFAULT_SYSTEM),
        max_tokens: common_max,
        temperature: temperature,
        timeout_ms: common_timeout,
        max_steps: common_steps,
        allow_exec: false,
        stream: env_or("RAYCODE_STREAM", "on") != "off",
        verbose: false,
        prompt: "",
        mcp_enabled: env_or("RAYCODE_MCP", "on") != "off",
        mcp_config: env_or("RAYCODE_MCP_CONFIG", ""),
        help: false,
        version: false,
        mcp_instructions: "",
        session_id: uuid.uuid_v4(),
        headers: [],
        autonomy: env_or("RAYCODE_AUTONOMY", if (ui.interactive()) {
            // Con un terminal delante se puede preguntar, así que se pregunta. Sin él no hay a
            // quién, y negarlo todo dejaría inservible el modo de un solo turno: las escrituras
            // se aplican —van al espacio de trabajo y a ningún otro sitio, que es lo que
            // garantiza `src/paths`— y los mandatos siguen necesitando que se digan.
            permissions.ASK
        } else { permissions.EDITS }),
        allowed_programs: allowed_from_env(),
        allowed_tools: [],
        mode: env_or("RAYCODE_MODE", modes.AGENT),
        key_source: "",
        max_tokens_field: MAX_TOKENS
    };
    if (profile == "llama" || profile == "local") {
        base.api = Api.OpenAI;
        base.base_url = env_or("RAYCODE_BASE_URL", "http://127.0.0.1:8080");
        base.api_key = env_or("RAYCODE_API_KEY", "");
        base.key_source = if (base.api_key == "") { "" } else { "env" };
        base.model = env_or("RAYCODE_MODEL", "local-model");
        Result.Ok(base)
    } else if (profile == "openai") {
        base.api = Api.OpenAI;
        base.base_url = env_or("RAYCODE_BASE_URL", "https://api.openai.com");
        base.api_key = env_or("OPENAI_API_KEY", env_or("RAYCODE_API_KEY", ""));
        base.key_source = if (base.api_key == "") { "" } else { "env" };
        base.model = env_or("RAYCODE_MODEL", "gpt-4o-mini");
        Result.Ok(base)
    } else if (profile == "responses" || profile == "codex") {
        base.api = Api.Responses;
        base.base_url = env_or("RAYCODE_BASE_URL", "https://api.openai.com");
        base.api_key = env_or("OPENAI_API_KEY", env_or("RAYCODE_API_KEY", ""));
        base.key_source = if (base.api_key == "") { "" } else { "env" };
        base.model = env_or("RAYCODE_MODEL", "gpt-5");
        Result.Ok(base)
    } else if (profile == "anthropic" || profile == "claude") {
        base.api = Api.Anthropic;
        base.base_url = env_or("RAYCODE_BASE_URL", "https://api.anthropic.com");
        base.api_key = env_or("ANTHROPIC_API_KEY", env_or("RAYCODE_API_KEY", ""));
        base.key_source = if (base.api_key == "") { "" } else { "env" };
        base.model = env_or("RAYCODE_MODEL", "claude-opus-5");
        Result.Ok(base)
    } else {
        Result.Err("unknown profile '${profile}' (use: llama, openai, responses, anthropic)")
    }
}

// Bandera con valor: devuelve el argumento siguiente o un Err con el nombre de la bandera.
fn value_of(argv: [string], i: int, flag: string) -> Result<string, string> {
    if (i + 1 < argv.len()) {
        Result.Ok(argv[i + 1])
    } else {
        Result.Err("missing value after ${flag}")
    }
}

/// Builds the configuration from the environment and then applies the command-line flags.
/// `RAYCODE_PROFILE` (or `--provider`) picks the preset; every other field has a flag.
pub fn load(argv: [string]) -> Result<Config, string> {
    // El perfil se resuelve primero: fija los valores por defecto que las banderas afinan.
    var profile = env_or("RAYCODE_PROFILE", "llama");
    var i = 0;
    while (i < argv.len()) {
        let a = argv[i];
        if (a == "--provider" || a == "-p") {
            profile = value_of(argv, i, a)?;
            i = i + 1;
        }
        i = i + 1;
    }
    var cfg = preset(profile)?;
    // Una autonomía puesta a mano gana sobre lo que implique cualquier otra bandera, venga
    // antes o después de ella.
    var autonomy_set = false;
    var positional: [string] = [];
    i = 0;
    while (i < argv.len()) {
        let a = argv[i];
        if (a == "--provider" || a == "-p") {
            i = i + 2;
        } else if (a == "--base-url" || a == "-u") {
            cfg.base_url = value_of(argv, i, a)?;
            i = i + 2;
        } else if (a == "--model" || a == "-m") {
            cfg.model = value_of(argv, i, a)?;
            i = i + 2;
        } else if (a == "--api-key" || a == "-k") {
            cfg.api_key = value_of(argv, i, a)?;
            cfg.key_source = "flag";
            i = i + 2;
        } else if (a == "--system" || a == "-s") {
            cfg.system = value_of(argv, i, a)?;
            i = i + 2;
        } else if (a == "--max-tokens") {
            let v = value_of(argv, i, a)?;
            cfg.max_tokens = parse_int(v).unwrap_or(cfg.max_tokens);
            i = i + 2;
        } else if (a == "--temperature" || a == "-t") {
            let v = value_of(argv, i, a)?;
            cfg.temperature = parse_float(v).unwrap_or(cfg.temperature);
            i = i + 2;
        } else if (a == "--timeout-ms") {
            let v = value_of(argv, i, a)?;
            cfg.timeout_ms = parse_int(v).unwrap_or(cfg.timeout_ms);
            i = i + 2;
        } else if (a == "--max-steps") {
            let v = value_of(argv, i, a)?;
            cfg.max_steps = parse_int(v).unwrap_or(cfg.max_steps);
            i = i + 2;
        } else if (a == "--no-stream") {
            cfg.stream = false;
            i = i + 1;
        } else if (a == "--allow-exec") {
            cfg.allow_exec = true;
            // La bandera dice literalmente «permite ejecutar», y lo que hacía hasta ahora
            // era eso: ofrecer la herramienta y correr lo que pidiera el modelo. Se
            // conserva — quien quiera que además pregunte pone `--autonomy ask` después.
            if (!autonomy_set) {
                cfg.autonomy = permissions.AUTO;
            }
            i = i + 1;
        } else if (a == "--autonomy") {
            let v = value_of(argv, i, a)?;
            if (!permissions.known(v)) {
                return Result.Err("unknown autonomy '${v}' (use: ${permissions.ids().join(", ")})");
            }
            cfg.autonomy = v;
            autonomy_set = true;
            i = i + 2;
        } else if (a == "--mode") {
            let v = value_of(argv, i, a)?;
            if (!modes.known(v)) {
                return Result.Err("unknown mode '${v}' (use: ${modes.ids().join(", ")})");
            }
            cfg.mode = v;
            i = i + 2;
        } else if (a == "--allow") {
            let v = value_of(argv, i, a)?;
            for name in v.split(",") {
                if (name.trim() != "") {
                    cfg.allowed_programs.push(name.trim());
                }
            }
            i = i + 2;
        } else if (a == "--mcp-config") {
            cfg.mcp_config = value_of(argv, i, a)?;
            i = i + 2;
        } else if (a == "--no-mcp") {
            cfg.mcp_enabled = false;
            i = i + 1;
        } else if (a == "--header" || a == "-H") {
            let v = value_of(argv, i, a)?;
            match (v.index_of(":")) {
                Option.Some(cut) => {
                    if (cut == 0) {
                        return Result.Err("bad header '${v}' (expected 'Name: value')");
                    }
                    cfg.headers.push(v);
                },
                Option.None => {
                    return Result.Err("bad header '${v}' (expected 'Name: value')");
                },
            }
            i = i + 2;
        } else if (a == "--verbose" || a == "-v") {
            cfg.verbose = true;
            i = i + 1;
        } else if (a == "--help" || a == "-h") {
            // Pedir ayuda no es arrancar: se sale antes de exigir modelo ni nada más.
            cfg.help = true;
            return Result.Ok(cfg);
        } else if (a == "--version" || a == "-V") {
            cfg.version = true;
            return Result.Ok(cfg);
        } else if (a.starts_with("-")) {
            return Result.Err("unknown flag '${a}'");
        } else {
            positional.push(a);
            i = i + 1;
        }
    }
    // Los argumentos sueltos son una petición de un solo turno (modo no interactivo).
    cfg.prompt = positional.join(" ");
    // El nombre del tope se decide con la URL ya fijada por las banderas, no con la del
    // perfil: apuntar `-p openai` a otro sitio es exactamente el caso que esto tiene que ver.
    cfg.max_tokens_field = token_field_for(cfg.base_url);
    // Y si nadie ha dado clave, se mira el llavero del sistema (raylang 1.27.3): una clave
    // guardada una vez no hay que volver a exportarla en cada shell.
    if (cfg.api_key.trim() == "") {
        match (stored_key(cfg.profile)) {
            Option.Some(key) => {
                cfg.api_key = key;
                cfg.key_source = "keychain";
            },
            Option.None => { },
        }
    }
    if (cfg.model.trim() == "") {
        return Result.Err("no model: pass --model or set RAYCODE_MODEL");
    }
    Result.Ok(cfg)
}

/// What the keychain files raycode's keys under: one service, one account per profile, so
/// the Anthropic key and the OpenAI one do not sit on top of each other.
pub const KEYCHAIN_SERVICE: string = "raycode";

/// The key stored for a profile, or None — including when there is no keychain to be had.
/// A machine without a secret service is a machine that keeps its key in the environment,
/// not one that cannot use raycode, so a failure here is quiet.
pub fn stored_key(profile: string) -> Option<string> {
    match (keychain.get(KEYCHAIN_SERVICE, profile)) {
        Result.Ok(found) => match (found) {
            Option.Some(key) => if (key.trim() == "") { Option.None } else { Option.Some(key) },
            Option.None => Option.None,
        },
        Result.Err(_e) => Option.None,
    }
}

/// Puts a profile's key in the system keychain — Keychain on macOS, the Secret Service on
/// Linux, the Credential Manager on Windows.
pub fn store_key(profile: string, key: string) -> Result<int, string> {
    keychain.set(KEYCHAIN_SERVICE, profile, key)
}

/// Takes it out again. True when there was one.
pub fn forget_key(profile: string) -> Result<bool, string> {
    keychain.delete(KEYCHAIN_SERVICE, profile)
}

/// The headers every request carries regardless of the protocol: the client's own
/// user agent (proxies such as opencode Go refuse generic ones), the conversation id
/// (`x-opencode-session`, the routing and cache key those proxies ask for) and the user's
/// extras from `-H`, which win over everything else.
pub fn common_headers(c: Config) -> Map<string, string> {
    var h: Map<string, string> = Map.new();
    h.insert("User-Agent", "raycode/${VERSION}");
    h.insert("x-opencode-session", c.session_id);
    for line in c.headers {
        match (line.index_of(":")) {
            Option.Some(cut) => {
                h.insert(line.substring(0, cut).trim(), line.substring(cut + 1, line.len()).trim());
            },
            Option.None => { },
        }
    }
    h
}

/// A fresh conversation id: what `/reset` does so the proxy stops linking the turns.
pub fn new_session(c: Config) {
    c.session_id = uuid.uuid_v4();
}

/// The system prompt as sent to the model: the user's, then what the autonomy level is
/// worth telling it, then whatever the MCP servers asked for in their `initialize` reply.
/// `/system` shows and edits only the first part; the rest follows the session.
pub fn system_prompt(c: Config) -> string {
    var parts: [string] = [];
    if (c.system.trim() != "") {
        parts.push(c.system);
    }
    let job = modes.prompt_for(c.mode);
    if (job != "") {
        parts.push(job);
    }
    let stance = permissions.prompt_for(c.autonomy);
    if (stance != "") {
        parts.push(stance);
    }
    if (c.mcp_instructions.trim() != "") {
        parts.push(c.mcp_instructions);
    }
    parts.join("\n\n")
}

/// The endpoint URL for a chat completion, derived from the base URL and the protocol.
pub fn chat_url(c: Config) -> string {
    var base = c.base_url;
    while (base.ends_with("/")) {
        base = base.substring(0, base.len() - 1);
    }
    // Si el usuario ya apuntó a la ruta completa, se respeta tal cual.
    if (base.contains("/chat/completions")
        || base.contains("/v1/messages")
        || base.ends_with("/responses")) {
        return base;
    }
    match (c.api) {
        Api.Anthropic => base + "/v1/messages",
        Api.OpenAI => if (base.ends_with("/v1")) {
            base + "/chat/completions"
        } else {
            base + "/v1/chat/completions"
        },
        Api.Responses => if (base.ends_with("/v1")) {
            base + "/responses"
        } else {
            base + "/v1/responses"
        },
    }
}
