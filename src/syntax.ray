// El color de un bloque de código, para el terminal.
//
// Es un resaltador DELIBERADAMENTE pequeño: cuatro papeles —comentario, cadena, número y
// palabra clave— y un perfil por familia de lenguaje. No es un analizador; no sabe de
// ámbitos, ni de tipos, ni de qué es una llamada. Para lo que sirve un bloque de código en
// una conversación de terminal —ver de un vistazo dónde acaba una cadena, que eso de ahí es
// un comentario, que esa palabra es una clave— llega de sobra, y cabe en un archivo.
//
// Lo que NO se hizo, y por qué: ray-sublime tiene un resaltador de verdad, sobre gramáticas
// `.sublime-syntax`, con sus 484 archivos de sintaxis y sus esquemas de color. Empotrar eso
// en una CLI para pintar diez líneas de shell sería pagar un motor entero por un adorno.
//
// El estado (dentro de un comentario de bloque, dentro de una cadena) CRUZA de una línea a
// la siguiente, y por eso se pinta línea a línea llevándolo a mano en vez de pintar el
// bloque entero de una vez: un tramo de color que cruzara un salto de línea se rompería al
// insertar el `│ ` del marco, y el comentario perdería el color a partir de la segunda.
import src/ui;

/// One language's surface, which is all this needs to know about it.
pub struct Language {
    /// The fence labels that pick it.
    names: [string],
    /// What starts a comment that runs to the end of the line.
    line_comment: [string],
    /// What opens and closes a comment that spans lines; "" for a language without them.
    block_open: string,
    block_close: string,
    /// The quote characters that open a string.
    quotes: [string],
    /// Whether a backslash escapes the next character inside a string.
    escapes: bool,
    keywords: [string],
}

/// Where a line left the scanner, so the next one starts where it ended.
pub struct Scan {
    in_block: bool,
    /// The quote that is still open, or "" outside a string.
    quote: string,
}

pub fn fresh() -> Scan {
    Scan { in_block: false, quote: "" }
}

// Las familias. Un lenguaje que no esté aquí se pinta con el perfil genérico, que solo
// conoce cadenas, números y las dos marcas de comentario más comunes — y eso, en un
