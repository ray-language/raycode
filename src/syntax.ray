// El perfil de quien no tiene perfil: lo que casi cualquier archivo de configuración o de
// código comparte, y nada más.
fn generic() -> Language {
    Language {
        names: [],
        line_comment: ["#", "//"],
        block_open: "",
        block_close: "",
        quotes: ["\"", "'"],
        escapes: true,
        keywords: []
    }
}

/// True for the fence labels that mean "this is not code": painting a block of plain output
/// would only invent meaning that is not there.
pub fn is_plain(label: string) -> bool {
    let name = label.trim().to_lower();
    // Markdown entra aquí: su `#` es un título, no un comentario, y el perfil genérico lo
    // apagaría entero.
    name == "text"
        || name == "txt"
        || name == "plain"
        || name == "output"
        || name == "log"
        || name == "md"
        || name == "markdown"
        || name == ""
}

/// True for the one "language" that is really a format: a patch, where the colour belongs to
/// whole lines rather than to what is in them.
pub fn is_diff(label: string) -> bool {
    let name = label.trim().to_lower();
    name == "diff" || name == "patch"
}

fn language_for(label: string) -> Language {
    let name = label.trim().to_lower();
    for l in languages() {
        if (l.names.contains(name)) {
            return l;
        }
    }
    generic()
}

/// The lines of `code`, painted for `label`. The state is carried from one line to the next,
/// so a string or a comment that spans lines keeps its colour all the way down.
pub fn paint_lines(label: string, lines: [string]) -> [string] {
    if (is_plain(label)) {
        return lines;
    }
    if (is_diff(label)) {
        var out: [string] = [];
        for line in lines {
            out.push(paint_diff(line));
        }
        return out;
    }
    let l = language_for(label);
    let state = fresh();
    var out: [string] = [];
    for line in lines {
        out.push(paint_line(l, line, state));
    }
    out
}

// Un parche: el color es de la línea entera, y lo que importa es qué lado es.
fn paint_diff(line: string) -> string {
    if (line.starts_with("+++") || line.starts_with("---")) {
        return ui.bold(line);
    }
    if (line.starts_with("@@")) {
        return ui.cyan(line);
    }
    if (line.starts_with("+")) {
        return ui.green(line);
    }
    if (line.starts_with("-")) {
        return ui.red(line);
    }
    line
}

// --- el barrido ---

fn is_digit(c: string) -> bool {
    let code = char_code(c[0]);
    code >= 48 && code <= 57
}

// Lo que puede ir dentro de un identificador: letras, dígitos, guion bajo, y el guion medio
// que usan las claves de configuración.
fn is_word(c: string) -> bool {
    let code = char_code(c[0]);
    (code >= 48 && code <= 57)
        || (code >= 65 && code <= 90)
        || (code >= 97 && code <= 122)
        || c == "_"
        || c == "-"
        || c == "$"
}

fn starts_word(c: string) -> bool {
    let code = char_code(c[0]);
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || c == "_" || c == "$"
}

// ¿Empieza `line` por `mark` en la posición `at`?
fn at_mark(line: string, at: int, mark: string) -> bool {
    mark != "" && at + mark.len() <= line.len() && line.substring(at, at + mark.len()) == mark
}

// Dónde acaba una cadena abierta en `from` con la comilla `quote`, y si llegó a cerrar en
// esta línea. El final es el índice PASADA la comilla de cierre, o el final de la línea.
fn string_end(l: Language, line: string, from: int, quote: string) -> (int, bool) {
    var j = from;
    while (j < line.len()) {
        let here = line.substring(j, j + 1);
        if (l.escapes && here == "\\" && j + 1 < line.len()) {
            j = j + 2;
        } else if (here == quote) {
            return (j + 1, true);
        } else {
            j = j + 1;
        }
    }
    (line.len(), false)
}

/// One line, painted, with `st` moved on to where the line ended.
pub fn paint_line(l: Language, line: string, st: Scan) -> string {
    var out = "";
    var plain = "";
    var i = 0;
    while (i < line.len()) {
        let c = line.substring(i, i + 1);
        // Dentro de un comentario de bloque: todo es comentario hasta que cierre.
        if (st.in_block) {
            // Si no cierra en esta línea, sigue abierto en la siguiente. (Que el final del
            // texto coincida con el final de la línea no significa que haya cerrado: eso
            // dejaba el comentario abierto sin color a partir de la segunda línea.)
            match (line.substring(i, line.len()).index_of(l.block_close)) {
                Option.Some(at) => {
                    let close = i + at + l.block_close.len();
                    out = out + ui.dim(line.substring(i, close));
                    st.in_block = false;
                    i = close;
                },
                Option.None => {
                    out = out + ui.dim(line.substring(i, line.len()));
                    i = line.len();
                },
            }
            continue;
        }
        // Dentro de una cadena que venía de la línea anterior: hasta la comilla que la
        // cierre, saltándose lo escapado.
        if (st.quote != "") {
            let ends = string_end(l, line, i, st.quote);
            out = out + ui.green(line.substring(i, ends.0));
            if (ends.1) {
                st.quote = "";
            }
            i = ends.0;
            continue;
        }
        var handled = false;
        // Un comentario de línea se come el resto y termina el trabajo.
        for mark in l.line_comment {
            if (!handled && at_mark(line, i, mark)) {
                out = out + plain + ui.dim(line.substring(i, line.len()));
                plain = "";
                i = line.len();
                handled = true;
            }
        }
        if (handled) {
            continue;
        }
        if (at_mark(line, i, l.block_open)) {
            out = out + plain;
            plain = "";
            st.in_block = true;
            // Sin avanzar: el `/*` es parte del comentario, y dejándolo para la rama de
            // arriba sale con el resto en UN tramo en vez de en dos del mismo color. No hay
            // bucle posible — esa rama siempre consume hasta el cierre o hasta el final.
            continue;
        }
        if (l.quotes.contains(c)) {
            // La comilla de apertura es parte de la cadena, y se pinta con ella en UN solo
            // tramo: dos tramos seguidos serían el mismo color con el doble de escapes.
            let ends = string_end(l, line, i + 1, c);
            out = out + plain + ui.green(line.substring(i, ends.0));
            plain = "";
            if (!ends.1) {
                st.quote = c;
            }
            i = ends.0;
            continue;
        }
        // Un número: solo cuando empieza de verdad, no en medio de `utf8` ni de `x2`.
        if (is_digit(c) && (i == 0 || !is_word(line.substring(i - 1, i)))) {
            var j = i;
            while (j < line.len()
                && (is_digit(line.substring(j, j + 1))
                    || line.substring(j, j + 1) == "."
                    || line.substring(j, j + 1) == "x")) {
                j = j + 1;
            }
            out = out + plain + ui.yellow(line.substring(i, j));
            plain = "";
            i = j;
            continue;
        }
        if (starts_word(c)) {
            var j = i;
            while (j < line.len() && is_word(line.substring(j, j + 1))) {
                j = j + 1;
            }
            let word = line.substring(i, j);
            if (l.keywords.contains(word)) {
                out = out + plain + ui.magenta(word);
                plain = "";
            } else {
                plain = plain + word;
            }
            i = j;
            continue;
        }
        plain = plain + c;
        i = i + 1;
    }
    out + plain
}
