// Adaptador del protocolo OpenAI (`POST /v1/chat/completions`), que es también el que
// sirve llama.cpp en modo servidor: mismos campos, mismo `tools`/`tool_calls`.
import std/json;
from std/json import Json;
from src/config import Config;
from src/message import Message, ToolCall, Reply;
import src/message;
from src/tools import Tool;
from src/usage import Usage;

fn jstr(s: string) -> Json {
    Json.JStr(s)
}

fn jint(n: int) -> Json {
    Json.JNum(n as float)
}

// Un objeto JSON a partir de pares alternados (clave, valor…): más legible que insertar
// campo a campo en cada mensaje.
fn obj(keys: [string], values: [Json]) -> Json {
    var m: Map<string, Json> = Map.new();
    var i = 0;
    while (i < keys.len() && i < values.len()) {
        m.insert(keys[i], values[i]);
        i = i + 1;
    }
    Json.JObject(m)
}

// La declaración de una herramienta en el esquema de OpenAI.
fn tool_json(t: Tool) -> Json {
    obj(
        ["type", "function"],
        [
            jstr("function"),
            obj(
                ["name", "description", "parameters"],
                [jstr(t.name), jstr(t.description), t.schema]
            )
        ]
    )
}

// Un turno del historial como mensaje del protocolo.
fn message_json(m: Message) -> Json {
    if (m.role == "tool") {
        return obj(
            ["role", "tool_call_id", "content"],
            [jstr("tool"), jstr(m.tool_call_id), jstr(m.text)]
        );
    }
    if (m.role == "assistant" && m.tool_calls.len() > 0) {
        var calls: [Json] = [];
        for c in m.tool_calls {
            calls.push(
                obj(
                    ["id", "type", "function"],
                    [
                        jstr(c.id),
                        jstr("function"),
                        obj(["name", "arguments"], [jstr(c.name), jstr(c.arguments)])
                    ]
                )
            );
        }
        return obj(
            ["role", "content", "tool_calls"],
            [jstr("assistant"), jstr(m.text), Json.JArray(calls)]
        );
    }
    obj(["role", "content"], [jstr(m.role), jstr(m.text)])
}

/// The JSON body of a chat completion request (non-streaming).
pub fn build_body(c: Config, tools: [Tool], history: [Message]) -> string {
    body_of(c, tools, history, false)
}

/// The same body, asking the endpoint to stream. `stream_options` is what makes it report
/// token usage at the end — without it a streamed answer comes back with no counts at all.
pub fn build_stream_body(c: Config, tools: [Tool], history: [Message]) -> string {
    body_of(c, tools, history, true)
}

fn body_of(c: Config, tools: [Tool], history: [Message], streaming: bool) -> string {
    var messages: [Json] = [];
    if (c.system.trim() != "") {
        messages.push(obj(["role", "content"], [jstr("system"), jstr(c.system)]));
    }
    for m in history {
        messages.push(message_json(m));
    }
    var keys = ["model", "messages", "max_tokens", "temperature", "stream"];
    var values = [
        jstr(c.model),
        Json.JArray(messages),
        jint(c.max_tokens),
        Json.JNum(c.temperature),
        Json.JBool(streaming)
    ];
    if (tools.len() > 0) {
        var decls: [Json] = [];
        for t in tools {
            decls.push(tool_json(t));
        }
        keys.push("tools");
        values.push(Json.JArray(decls));
        keys.push("tool_choice");
        values.push(jstr("auto"));
    }
    if (streaming) {
        keys.push("stream_options");
        values.push(obj(["include_usage"], [Json.JBool(true)]));
    }
    json.stringify(obj(keys, values))
}

/// The HTTP headers for this endpoint (the key is optional: llama.cpp usually has none).
pub fn headers(c: Config) -> Map<string, string> {
    var h: Map<string, string> = Map.new();
    h.insert("Content-Type", "application/json");
    h.insert("Accept", "application/json");
    if (c.api_key.trim() != "") {
        h.insert("Authorization", "Bearer ${c.api_key}");
    }
    h
}

fn string_or(j: Json, key: string, fallback: string) -> string {
    match (json.get_string(j, key)) {
        Option.Some(s) => s,
        Option.None => fallback,
    }
}

fn int_or(j: Json, key: string, fallback: int) -> int {
    match (json.get_int(j, key)) {
        Option.Some(n) => n,
        Option.None => fallback,
    }
}

// Los tokens de prompt servidos desde caché viven anidados (`prompt_tokens_details`).
fn cached_of(u: Json) -> int {
    match (json.get_object(u, "prompt_tokens_details")) {
        Option.Some(_) => match (json.member(u, "prompt_tokens_details")) {
            Option.Some(d) => int_or(d, "cached_tokens", 0),
            Option.None => 0,
        },
        Option.None => 0,
    }
}

/// Parses a chat completion response into the harness's canonical reply.
pub fn parse_reply(body: string) -> Result<Reply, string> {
    let root = json.parse(body)?;
    // Un error del proveedor llega con 200 en algunos servidores: se detecta por el campo.
    match (json.member(root, "error")) {
        Option.Some(e) => {
            let detail = match (json.get_string(e, "message")) {
                Option.Some(m) => m,
                Option.None => json.stringify(e),
            };
            return Result.Err("provider error: ${detail}");
        },
        Option.None => { },
    }
    let choices = match (json.get_array(root, "choices")) {
        Option.Some(a) => a,
        Option.None => {
            return Result.Err("malformed response: no 'choices' array");
        },
    };
    if (choices.len() == 0) {
        return Result.Err("malformed response: empty 'choices'");
    }
    let choice = choices[0];
    let msg = match (json.member(choice, "message")) {
        Option.Some(m) => m,
        Option.None => {
            return Result.Err("malformed response: choice without 'message'");
        },
    };
    let text = string_or(msg, "content", "");
    var calls: [ToolCall] = [];
    match (json.get_array(msg, "tool_calls")) {
        Option.Some(list) => {
            for c in list {
                let f = match (json.member(c, "function")) {
                    Option.Some(f) => f,
                    Option.None => c,
                };
                calls.push(
                    ToolCall {
                        id: string_or(c, "id", "call_${calls.len()}"),
                        name: string_or(f, "name", ""),
                        arguments: string_or(f, "arguments", "{}")
                    }
                );
            }
        },
        Option.None => { },
    }
    var used = Usage {
        input_tokens: 0,
        output_tokens: 0,
        cached_tokens: 0,
        requests: 1,
        latency_ms: 0,
        measured: 0,
        estimated: 0
    };
    match (json.member(root, "usage")) {
        Option.Some(u) => {
            used.input_tokens = int_or(u, "prompt_tokens", 0);
            used.output_tokens = int_or(u, "completion_tokens", 0);
            used.cached_tokens = cached_of(u);
        },
        Option.None => { },
    }
    // Un `usage` ausente, nulo o en blanco NO es "cero tokens": es "no informado".
    if (used.input_tokens > 0 || used.output_tokens > 0) {
        used.measured = 1;
    }
    Result.Ok(
        Reply {
            message: message.assistant(text, calls),
            usage: used,
            stop_reason: string_or(choice, "finish_reason", ""),
            model: string_or(root, "model", "")
        }
    )
}

// ---------------------------------------------------------------------------------------
// Streaming: el ensamblado de una respuesta que llega por trozos
// ---------------------------------------------------------------------------------------

/// A streamed answer under construction. It is fed one SSE payload at a time and ends as a
/// normal `Reply`, so the rest of the harness never learns whether the answer arrived in
/// one piece or in two hundred.
pub struct Assembly {
    text: string,
    calls: [ToolCall],
    usage: Usage,
    stop_reason: string,
    model: string,
    done: bool,
}

/// An empty assembly.
pub fn assembly() -> Assembly {
    let none: [ToolCall] = [];
    Assembly {
        text: "",
        calls: none,
        usage: Usage {
            input_tokens: 0,
            output_tokens: 0,
            cached_tokens: 0,
            requests: 1,
            latency_ms: 0,
            measured: 0,
            estimated: 0
        },
        stop_reason: "",
        model: "",
        done: false
    }
}

// La llamada en la posición `index`, creándola si es la primera vez que se ve. Los
// argumentos llegan partidos en trozos arbitrarios, así que se van concatenando.
fn slot(a: Assembly, index: int) -> ToolCall {
    while (a.calls.len() <= index) {
        a.calls.push(ToolCall { id: "", name: "", arguments: "" });
    }
    a.calls[index]
}

/// Absorbs one `data:` payload and returns the text it produced — what there is to paint
/// right now. Anything unrecognised is ignored: a stream is not a place to be strict.
pub fn absorb(a: Assembly, data: string) -> string {
    let payload = data.trim();
    if (payload == "[DONE]") {
        a.done = true;
        return "";
    }
    let root = match (json.parse(payload)) {
        Result.Ok(j) => j,
        Result.Err(_) => {
            return "";
        },
    };
    if (a.model == "") {
        a.model = string_or(root, "model", "");
    }
    match (json.member(root, "usage")) {
        Option.Some(u) => {
            let input = int_or(u, "prompt_tokens", 0);
            let output = int_or(u, "completion_tokens", 0);
            if (input > 0 || output > 0) {
                a.usage.input_tokens = input;
                a.usage.output_tokens = output;
                a.usage.cached_tokens = cached_of(u);
                a.usage.measured = 1;
            }
        },
        Option.None => { },
    }
    let choices = match (json.get_array(root, "choices")) {
        Option.Some(list) => list,
        Option.None => {
            return "";
        },
    };
    if (choices.len() == 0) {
        return "";
    }
    let choice = choices[0];
    let reason = string_or(choice, "finish_reason", "");
    if (reason != "") {
        a.stop_reason = reason;
    }
    let delta = match (json.member(choice, "delta")) {
        Option.Some(d) => d,
        Option.None => {
            return "";
        },
    };
    match (json.get_array(delta, "tool_calls")) {
        Option.Some(list) => {
            for call in list {
                let target = slot(a, int_or(call, "index", 0));
                let id = string_or(call, "id", "");
                if (id != "") {
                    target.id = id;
                }
                match (json.member(call, "function")) {
                    Option.Some(f) => {
                        let name = string_or(f, "name", "");
                        if (name != "") {
                            target.name = name;
                        }
                        target.arguments = target.arguments + string_or(f, "arguments", "");
                    },
                    Option.None => { },
                }
            }
        },
        Option.None => { },
    }
    let piece = string_or(delta, "content", "");
    a.text = a.text + piece;
    piece
}

/// The assembled reply. Calls with no id get one: a tool result has to answer something.
pub fn assembled(a: Assembly) -> Reply {
    var i = 0;
    while (i < a.calls.len()) {
        if (a.calls[i].id == "") {
            a.calls[i].id = "call_${i}";
        }
        i = i + 1;
    }
    Reply {
        message: message.assistant(a.text, a.calls),
        usage: a.usage,
        stop_reason: a.stop_reason,
        model: a.model
    }
}
