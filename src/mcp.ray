// Cliente MCP (Model Context Protocol) por stdio. Las herramientas de un servidor MCP
// entran en el catálogo que raycode ofrece al modelo, junto a `read_file` y compañía,
// sin que el bucle del agente distinga unas de otras.
//
// Transporte: UNA SESIÓN POR SERVIDOR. Cada servidor se lanza una vez, con su stdin abierto
// (`stdin_pipe`), y vive lo que la sesión: el apretón de manos se hace al arrancar y cada
// petición es una línea JSON-RPC que espera su respuesta por `id`. El proceso lo posee UNA
// fibra —el actor— y el resto del harness le habla por canal: la sesión se copia a la
// fibra que atiende cada paso, y un handle de proceso no puede copiarse, pero un canal sí
// sigue apuntando al mismo actor desde cualquier copia. Un servidor que muere o se cuelga
// se mata, se informa del error, y se relanza en la siguiente petición.
//
// El otro transporte es HTTP ("Streamable HTTP" del protocolo): cada petición es un POST
// con la línea JSON-RPC, y la respuesta llega como JSON o como flujo SSE con el evento que
// lleva la misma `id`. La sesión la identifica la cabecera `Mcp-Session-Id` que devuelve
// el `initialize`; un 404 con ella es "sesión caducada" y se vuelve a inicializar. Mismo
// actor, mismo canal: para el resto del harness no hay diferencia.
import std/json;
import std/process;
import std/time;
import std/fs;
import src/ui;
import src/config;
import net/http;
import net/sse;
from std/json import Json;

/// One MCP server as configured, plus what discovery learned about it. `note` keeps
/// the last error (empty when healthy), `tool_count` what the catalogue holds,
/// `instructions` the system-prompt text the server declared in `initialize`, and `link`
/// the channel to the fiber that owns its process (`running` says whether it is up).
pub struct Server {
    name: string,
    command: string,
    args: [string],
    dir: string,
    env: Map<string, string>,
    url: string,
    headers: Map<string, string>,
    enabled: bool,
    note: string,
    tool_count: int,
    instructions: string,
    resources: [Resource],
    link: Channel<Request>,
    running: bool,
}

/// One resource a server publishes: something the model (or the user) can read by URI.
pub struct Resource {
    uri: string,
    name: string,
    description: string,
    mime: string,
}

/// What the harness sends to a server's actor: a request to forward, or the order to stop.
pub enum Request {
    Ask(string, Json, int, Channel<Result<Answer, string>>),
    Stop(Channel<int>),
}

/// A server's reply: the `result` of the request, plus the instructions it declared when
/// it was initialised.
pub struct Answer {
    result: Json,
    instructions: string,
}

/// A tool as the server declares it: raw name, description and its JSON Schema. It is
/// `src/tools` who wraps it into the catalogue, so this module never imports it.
pub struct RemoteTool {
    name: string,
    description: string,
    schema: Json,
}

/// The wire version this client speaks.
pub const PROTOCOL_VERSION: string = "2024-11-05";

/// How long `tools/list` may take per server before the server is marked unavailable.
pub const DISCOVER_TIMEOUT_MS: int = 5000;

/// How long one `tools/call` may take before the server process is killed.
pub const CALL_TIMEOUT_MS: int = 60000;

// La `id` del `initialize`; las peticiones siguientes cuentan desde la 2.
const HELLO_ID: int = 1;

// Cuánto se espera a que un servidor termine por las buenas tras cerrarle stdin.
const STOP_GRACE_MS: int = 2000;

const NAME_PREFIX: string = "mcp__";

const NAME_SEPARATOR: string = "__";

fn jstr(s: string) -> Json {
    Json.JStr(s)
}

fn obj(keys: [string], values: [Json]) -> Json {
    var m: Map<string, Json> = Map.new();
    var i = 0;
    while (i < keys.len() && i < values.len()) {
        m.insert(keys[i], values[i]);
        i = i + 1;
    }
    Json.JObject(m)
}

// El objeto vacío como Json.
fn empty_object() -> Json {
    let m: Map<string, Json> = Map.new();
    Json.JObject(m)
}

/// The name the model sees for tool `tool` of server `server`: `mcp__<server>__<tool>`,
/// the convention Claude Code uses, so names never collide with the builtins and the
/// origin reads off the trace.
pub fn tool_name(server: string, tool: string) -> string {
    NAME_PREFIX + server + NAME_SEPARATOR + tool
}

/// True when `name` is the exposed name of an MCP tool.
pub fn is_remote(name: string) -> bool {
    name.starts_with(NAME_PREFIX)
}

/// The inverse of `tool_name`: the server and the raw tool name, or None when `name`
/// does not follow the convention.
pub fn split_name(name: string) -> Option<(string, string)> {
    if (!is_remote(name)) {
        return Option.None;
    }
    let rest = name.substring(NAME_PREFIX.len(), name.len());
    let cut = match (rest.index_of(NAME_SEPARATOR)) {
        Option.Some(i) => i,
        Option.None => -1,
    };
    if (cut <= 0 || cut + NAME_SEPARATOR.len() >= rest.len()) {
        return Option.None;
    }
    Option.Some((rest.substring(0, cut), rest.substring(cut + NAME_SEPARATOR.len(), rest.len())))
}

/// The server called `name`, if configured.
pub fn find(servers: [Server], name: string) -> Option<Server> {
    for s in servers {
        if (s.name == name) {
            return Option.Some(s);
        }
    }
    Option.None
}

// ---------------------------------------------------------------- configuración

/// The configuration file to use: `explicit` when given, else `.raycode/mcp.json` in the
/// workspace, else `~/.raycode/mcp.json`; None when none of them exists.
pub fn config_path(explicit: string) -> Option<string> {
    if (explicit.trim() != "") {
        return Option.Some(explicit);
    }
    let local = ui.resolve_path(".raycode/mcp.json");
    if (fs.is_file(local)) {
        return Option.Some(local);
    }
    match (env("HOME")) {
        Option.Some(home) => {
            let global = home + "/.raycode/mcp.json";
            if (fs.is_file(global)) { Option.Some(global) } else { Option.None }
        },
        Option.None => Option.None,
    }
}

// Una lista de strings JSON; cualquier otra cosa es un error de configuración.
fn string_list(j: Json, what: string) -> Result<[string], string> {
    var out: [string] = [];
    match (j) {
        Json.JArray(items) => {
            for item in items {
                match (json.as_string(item)) {
                    Option.Some(s) => out.push(s),
                    Option.None => {
                        return Result.Err("${what} must be a list of strings");
                    },
                }
            }
            Result.Ok(out)
        },
        _ => Result.Err("${what} must be a list of strings"),
    }
}

// Un servidor del sobre `mcpServers`.
fn parse_server(name: string, spec: Json) -> Result<Server, string> {
    if (name.trim() == "" || name.contains(NAME_SEPARATOR)) {
        return Result.Err("server name '${name}' is empty or contains '__'");
    }
    // Dos transportes: `command` (stdio, un proceso hijo) o `url` (HTTP). Uno de los dos.
    let url = match (json.get_string(spec, "url")) {
        Option.Some(u) => u.trim(),
        Option.None => "",
    };
    let command = match (json.get_string(spec, "command")) {
        Option.Some(c) => c,
        Option.None => {
            if (url == "") {
                return Result.Err("server '${name}' has neither \"command\" nor \"url\"");
            }
            ""
        },
    };
    if (url != "" && !(url.starts_with("http://") || url.starts_with("https://"))) {
        return Result.Err("server '${name}': the url must start with http:// or https://");
    }
    var extra_headers: Map<string, string> = Map.new();
    match (json.get_object(spec, "headers")) {
        Option.Some(m) => {
            for k in m.keys() {
                match (get(m, k)) {
                    Option.Some(v) => match (json.as_string(v)) {
                        Option.Some(text) => extra_headers.insert(k, text),
                        Option.None => {
                            return Result.Err("server '${name}': headers.${k} must be a string");
                        },
                    },
                    Option.None => { },
                }
            }
        },
        Option.None => { },
    }
    let none: [string] = [];
    let arguments = match (json.member(spec, "args")) {
        Option.Some(a) => string_list(a, "server '${name}': \"args\"")?,
        Option.None => none,
    };
    var environment: Map<string, string> = Map.new();
    match (json.get_object(spec, "env")) {
        Option.Some(m) => {
            for k in m.keys() {
                match (get(m, k)) {
                    Option.Some(v) => match (json.as_string(v)) {
                        Option.Some(s) => environment.insert(k, s),
                        Option.None => {
                            return Result.Err("server '${name}': env.${k} must be a string");
                        },
                    },
                    Option.None => { },
                }
            }
        },
        Option.None => { },
    }
    let dir = match (json.get_string(spec, "dir")) {
        Option.Some(d) => d,
        Option.None => "",
    };
    let disabled = match (json.get_bool(spec, "disabled")) {
        Option.Some(d) => d,
        Option.None => false,
    };
    let link: Channel<Request> = Channel.new();
    Result.Ok(
        Server { name: name, command: command, args: arguments, dir: dir, env: environment, url: url, headers: extra_headers, enabled: !disabled, note: if (disabled) { "disabled in the configuration" } else { "" }, tool_count: 0, instructions: "", resources: [], link: link, running: false }
    )
}

/// Parses the standard `{"mcpServers": {name: {command, args, env, dir, disabled}}}`
/// envelope (the one Claude Code and Claude Desktop use, so a block can be pasted as is).
pub fn parse_config(text: string) -> Result<[Server], string> {
    let root = json.parse(text)?;
    let table = match (json.get_object(root, "mcpServers")) {
        Option.Some(t) => t,
        Option.None => {
            return Result.Err("expected an object under \"mcpServers\"");
        },
    };
    var servers: [Server] = [];
    // Las claves ordenadas: el catálogo debe ser el mismo en cada arranque.
    for name in table.keys().sort() {
        match (get(table, name)) {
            Option.Some(spec) => servers.push(parse_server(name, spec)?),
            Option.None => { },
        }
    }
    Result.Ok(servers)
}

/// The configured servers: an empty list when there is no configuration file, an error
/// when there is one and it is unusable.
pub fn load(explicit: string) -> Result<[Server], string> {
    match (config_path(explicit)) {
        Option.None => Result.Ok([]),
        Option.Some(path) => {
            let text = match (fs.read_file(path)) {
                Result.Ok(t) => t,
                Result.Err(e) => {
                    return Result.Err("cannot read ${path}: ${e}");
                },
            };
            match (parse_config(text)) {
                Result.Ok(servers) => Result.Ok(servers),
                Result.Err(e) => Result.Err("${path}: ${e}"),
            }
        },
    }
}

// ---------------------------------------------------------------- protocolo

/// The two lines that open a session: `initialize` (id 1) and the `initialized`
/// notification.
pub fn handshake() -> string {
    let hello = request(
        HELLO_ID,
        "initialize",
        obj(
            ["protocolVersion", "capabilities", "clientInfo"],
            [
                jstr(PROTOCOL_VERSION),
                empty_object(),
                obj(["name", "version"], [jstr("raycode"), jstr(config.VERSION)])
            ]
        )
    );
    let ready = json.stringify(
        obj(["jsonrpc", "method"], [jstr("2.0"), jstr("notifications/initialized")])
    );
    hello + "\n" + ready + "\n"
}

/// One request line (no trailing newline).
pub fn request(id: int, method: string, params: Json) -> string {
    json.stringify(
        obj(
            ["jsonrpc", "id", "method", "params"],
            [jstr("2.0"), Json.JNum(id as float), jstr(method), params]
        )
    )
}

/// The reply line whose `id` is `id`, out of everything the server wrote to stdout.
/// Lines that are not JSON (a stray log) are skipped.
pub fn pick(output: string, id: int) -> Option<Json> {
    for line in output.split("\n") {
        if (line.trim() != "") {
            match (json.parse(line.trim())) {
                Result.Ok(j) => match (json.get_int(j, "id")) {
                    Option.Some(found) => {
                        if (found == id) {
                            return Option.Some(j);
                        }
                    },
                    Option.None => { },
                },
                Result.Err(_) => { },
            }
        }
    }
    Option.None
}

// El `result` de una respuesta, o el `error` del protocolo como Err.
fn result_of(reply: Json) -> Result<Json, string> {
    match (json.member(reply, "error")) {
        Option.Some(e) => {
            let text = match (json.get_string(e, "message")) {
                Option.Some(m) => m,
                Option.None => json.stringify(e),
            };
            let code = match (json.get_int(e, "code")) {
                Option.Some(c) => " (code ${c})",
                Option.None => "",
            };
            Result.Err("the server answered an error: ${text}${code}")
        },
        Option.None => match (json.member(reply, "result")) {
            Option.Some(r) => Result.Ok(r),
            Option.None => Result.Err("the reply has neither \"result\" nor \"error\""),
        },
    }
}

/// The text of a `tools/call` result: its `content` blocks joined, text ones verbatim and
/// the rest summarised (`[image 12 KiB]`). `isError: true` comes back as Err so it takes
/// the same "error to the model, never a panic" path the builtins use.
pub fn flatten(result: Json) -> Result<string, string> {
    var parts: [string] = [];
    match (json.get_array(result, "content")) {
        Option.Some(blocks) => {
            for block in blocks {
                let kind = match (json.get_string(block, "type")) {
                    Option.Some(t) => t,
                    Option.None => "unknown",
                };
                if (kind == "text") {
                    match (json.get_string(block, "text")) {
                        Option.Some(t) => parts.push(t),
                        Option.None => { },
                    }
                } else {
                    let size = match (json.get_string(block, "data")) {
                        Option.Some(d) => " ${d.len() * 3 / 4 / 1024} KiB",
                        Option.None => "",
                    };
                    parts.push("[${kind}${size}]");
                }
            }
        },
        Option.None => match (json.member(result, "structuredContent")) {
            Option.Some(s) => parts.push(json.stringify(s)),
            Option.None => { },
        },
    }
    let text = parts.join("\n");
    let failed = match (json.get_bool(result, "isError")) {
        Option.Some(f) => f,
        Option.None => false,
    };
    if (failed) {
        Result.Err(if (text.trim() == "") { "the tool reported an error" } else { text })
    } else {
        Result.Ok(text)
    }
}

/// The resources a `resources/list` result declares.
pub fn parse_resources(result: Json) -> Result<[Resource], string> {
    let items = match (json.get_array(result, "resources")) {
        Option.Some(r) => r,
        Option.None => {
            return Result.Err("the reply to resources/list has no \"resources\" list");
        },
    };
    var resources: [Resource] = [];
    for item in items {
        let uri = match (json.get_string(item, "uri")) {
            Option.Some(u) => u,
            Option.None => {
                return Result.Err("a resource in resources/list has no uri");
            },
        };
        let text_of = fn(key: string) -> string {
            match (json.get_string(item, key)) {
                Option.Some(v) => v,
                Option.None => "",
            }
        };
        resources.push(
            Resource {
                uri: uri,
                name: text_of("name"),
                description: text_of("description"),
                mime: text_of("mimeType")
            }
        );
    }
    Result.Ok(resources)
}

/// The text of a `resources/read` result: its `contents` joined, text entries verbatim
/// and binary ones summarised (`[blob 12 KiB image/png]`).
pub fn flatten_contents(result: Json) -> Result<string, string> {
    let entries = match (json.get_array(result, "contents")) {
        Option.Some(c) => c,
        Option.None => {
            return Result.Err("the reply to resources/read has no \"contents\" list");
        },
    };
    var parts: [string] = [];
    for entry in entries {
        match (json.get_string(entry, "text")) {
            Option.Some(text) => parts.push(text),
            Option.None => match (json.get_string(entry, "blob")) {
                Option.Some(blob) => {
                    let mime = match (json.get_string(entry, "mimeType")) {
                        Option.Some(m) => " " + m,
                        Option.None => "",
                    };
                    parts.push("[blob ${blob.len() * 3 / 4 / 1024} KiB${mime}]");
                },
                Option.None => { },
            },
        }
    }
    Result.Ok(parts.join("\n"))
}

/// The tools a `tools/list` result declares. A tool without a schema gets an empty
/// object schema, which every provider accepts.
pub fn parse_tools(result: Json) -> Result<[RemoteTool], string> {
    let items = match (json.get_array(result, "tools")) {
        Option.Some(t) => t,
        Option.None => {
            return Result.Err("the reply to tools/list has no \"tools\" list");
        },
    };
    var tools: [RemoteTool] = [];
    for item in items {
        let name = match (json.get_string(item, "name")) {
            Option.Some(n) => n,
            Option.None => {
                return Result.Err("a tool in tools/list has no name");
            },
        };
        let description = match (json.get_string(item, "description")) {
            Option.Some(d) => d,
            Option.None => "",
        };
        let schema = match (json.member(item, "inputSchema")) {
            Option.Some(s) => s,
            Option.None => obj(["type", "properties"], [jstr("object"), empty_object()]),
        };
        tools.push(RemoteTool { name: name, description: description, schema: schema });
    }
    Result.Ok(tools)
}

// ---------------------------------------------------------------- transporte

// El proceso vivo, propiedad exclusiva del actor: el handle, lo leído y aún no consumido
// de su stdout, la siguiente `id` y lo que declaró al inicializarse.
struct Live {
    proc: process.Proc,
    pending: bytes,
    next_id: int,
    instructions: string,
    dead: bool,
}

// Deja pasar stderr sin guardarlo: si nadie lo lee, el canal acotado se llena y el
// servidor se bloquea escribiendo un log.
fn discard(channel: Channel<bytes>) {
    var draining = true;
    while (draining) {
        match (recv(channel)) {
            Option.Some(_) => { },
            Option.None => {
                draining = false;
            },
        }
    }
}

fn exit_label(code: process.Exit) -> string {
    match (code) {
        process.Exit.Code(c) => "exit ${c}",
        process.Exit.Signal(sig) => "signal ${sig}",
    }
}

// La siguiente línea completa del búfer, si la hay. Un trozo puede partir un carácter:
// entonces se espera al siguiente en vez de decodificar a medias.
fn take_line(live: Live) -> Option<string> {
    match (from_utf8(live.pending)) {
        Result.Err(_) => Option.None,
        Result.Ok(text) => match (text.index_of("\n")) {
            Option.None => Option.None,
            Option.Some(i) => {
                live.pending = text.substring(i + 1, text.len()).to_bytes();
                Option.Some(text.substring(0, i))
            },
        },
    }
}

// Mata el proceso y lo da por muerto: la siguiente petición lo relanza.
fn bury(live: Live) {
    live.proc.kill(true);
    live.proc.wait();
    live.dead = true;
}

// Espera la respuesta con `id`, saltando lo que no sea (notificaciones, logs). Un plazo
// vencido o un EOF matan la sesión: el error dice cuál de los dos.
fn await_reply(live: Live, id: int, timeout_ms: int) -> Result<Json, string> {
    let deadline = time.monotonic() + timeout_ms;
    while (true) {
        var scanning = true;
        while (scanning) {
            match (take_line(live)) {
                Option.None => {
                    scanning = false;
                },
                Option.Some(line) => {
                    if (line.trim() != "") {
                        match (json.parse(line.trim())) {
                            Result.Err(_) => { },
                            Result.Ok(reply) => match (json.get_int(reply, "id")) {
                                Option.Some(found) => {
                                    if (found == id) {
                                        return result_of(reply);
                                    }
                                },
                                Option.None => { },
                            },
                        }
                    }
                },
            }
        }
        let remaining = deadline - time.monotonic();
        if (remaining <= 0) {
            bury(live);
            return Result.Err("no reply after ${timeout_ms}ms; the server was killed");
        }
        match (select_timeout([live.proc.out], remaining)) {
            Option.None => {
                bury(live);
                return Result.Err("no reply after ${timeout_ms}ms; the server was killed");
            },
            Option.Some(_) => match (recv(live.proc.out)) {
                Option.Some(chunk) => {
                    live.pending = live.pending + chunk;
                },
                Option.None => {
                    let status = exit_label(live.proc.wait());
                    live.dead = true;
                    return Result.Err("the server exited (${status}) before answering");
                },
            },
        }
    }
    Result.Err("unreachable")
}

// Escribe una línea al stdin del servidor. `write` aparca la fibra si el pipe se llena
// (contrapresión real) y devuelve Err si el servidor cerró su stdin o murió.
fn write_line(live: Live, text: string) -> Result<int, string> {
    match (live.proc.write((text + "\n").to_bytes())) {
        Result.Ok(n) => Result.Ok(n),
        Result.Err(e) => {
            live.dead = true;
            Result.Err("cannot write to the server (${e})")
        },
    }
}

// Lanza el proceso y hace el apretón de manos.
fn launch(s: Server, timeout_ms: int) -> Result<Live, string> {
    var command = process.cmd(s.command, s.args).stdin_pipe();
    command = command.dir(if (s.dir.trim() == "") { ui.workspace() } else { ui.resolve_path(s.dir) });
    for k in s.env.keys() {
        match (get(s.env, k)) {
            Option.Some(v) => {
                command = command.env(k, v);
            },
            Option.None => { },
        }
    }
    let p = match (command.stream()) {
        Result.Ok(proc) => proc,
        Result.Err(e) => {
            return Result.Err("cannot start '${s.command}': ${e}");
        },
    };
    spawn(fn() {
        discard(p.err);
    });
    let live = Live { proc: p, pending: b"", next_id: HELLO_ID + 1, instructions: "", dead: false };
    let hello: Result<Json, string> = match (write_line(live, handshake().trim())) {
        Result.Ok(_) => await_reply(live, HELLO_ID, timeout_ms),
        Result.Err(e) => Result.Err(e),
    };
    match (hello) {
        Result.Err(e) => {
            if (!live.dead) {
                bury(live);
            }
            Result.Err("initialize failed: ${e}")
        },
        Result.Ok(result) => {
            live.instructions = match (json.get_string(result, "instructions")) {
                Option.Some(text) => text.trim(),
                Option.None => "",
            };
            Result.Ok(live)
        },
    }
}

// Una petición sobre la sesión viva.
fn exchange(live: Live, method: string, params: Json, timeout_ms: int) -> Result<Answer, string> {
    let id = live.next_id;
    live.next_id = live.next_id + 1;
    write_line(live, request(id, method, params))?;
    let result = await_reply(live, id, timeout_ms)?;
    Result.Ok(Answer { result: result, instructions: live.instructions })
}

// Cierra la sesión por las buenas (EOF en stdin) y, si el servidor no se va, a la fuerza.
fn hang_up(live: Live) {
    if (live.dead) {
        return;
    }
    live.proc.close_stdin();
    spawn(fn() {
        time.sleep(STOP_GRACE_MS);
        live.proc.kill(true);
    });
    live.proc.wait();
    live.dead = true;
}

// El actor: la única fibra que toca el proceso. Atiende peticiones hasta que le mandan
// parar; un servidor caído se relanza en la siguiente petición.
fn serve(s: Server) {
    var live: Option<Live> = Option.None;
    var serving = true;
    while (serving) {
        match (recv(s.link)) {
            Option.None => {
                serving = false;
            },
            Option.Some(req) => match (req) {
                Request.Stop(ack) => {
                    match (live) {
                        Option.Some(l) => hang_up(l),
                        Option.None => { },
                    }
                    live = Option.None;
                    serving = false;
                    send(ack, 1);
                },
                Request.Ask(method, params, timeout_ms, reply) => {
                    let ready: Result<Live, string> = match (live) {
                        Option.Some(l) => Result.Ok(l),
                        Option.None => launch(s, timeout_ms),
                    };
                    match (ready) {
                        Result.Err(e) => {
                            let failed: Result<Answer, string> = Result.Err(e);
                            send(reply, failed);
                        },
                        Result.Ok(l) => {
                            let outcome = exchange(l, method, params, timeout_ms);
                            live = if (l.dead) { Option.None } else { Option.Some(l) };
                            send(reply, outcome);
                        },
                    }
                },
            },
        }
    }
}

// ---------------------------------------------------------------- transporte HTTP

// La sesión HTTP: la `id` que dio el servidor al inicializar (vacía si no usa sesiones),
// la siguiente `id` de petición y las instrucciones declaradas.
struct Web {
    session_id: string,
    next_id: int,
    instructions: string,
}

// Cuánto cuerpo se guarda de una respuesta de error, para el mensaje.
const MAX_ERROR_BODY: int = 512;

// Cuánto se lee de un flujo SSE antes de rendirse buscando la respuesta.
const MAX_STREAM_BYTES: int = 16777216;

// Las cabeceras de cada POST: las del protocolo, la sesión si la hay, y las del usuario
// (Authorization y similares) encima.
fn http_headers(s: Server, session_id: string) -> Map<string, string> {
    var h: Map<string, string> = Map.new();
    h.insert("Content-Type", "application/json");
    h.insert("Accept", "application/json, text/event-stream");
    h.insert("MCP-Protocol-Version", PROTOCOL_VERSION);
    if (session_id != "") {
        h.insert("Mcp-Session-Id", session_id);
    }
    for k in s.headers.keys() {
        match (get(s.headers, k)) {
            Option.Some(v) => {
                h.insert(k, v);
            },
            Option.None => { },
        }
    }
    h
}

// Una cabecera de la respuesta, sin distinguir mayúsculas.
fn header_of(headers: Map<string, string>, name: string) -> string {
    match (get(headers, name.to_lower())) {
        Option.Some(v) => v,
        Option.None => match (get(headers, name)) {
            Option.Some(v) => v,
            Option.None => "",
        },
    }
}

// ¿Es esta línea la respuesta con `id`? Devuelve su `result` o el error del protocolo.
fn reply_with_id(text: string, id: int) -> Option<Result<Json, string>> {
    match (json.parse(
    text.trim()
)) {
        Result.Err(_) => Option.None,
        Result.Ok(reply) => match (json.get_int(reply, "id")) {
            Option.Some(found) => if (found == id) { Option.Some(result_of(reply)) } else { Option.None },
            Option.None => Option.None,
        },
    }
}

// Lo que salió por un POST: el estado, las cabeceras y el `result` con `id` (JNull para
// las notificaciones, que no tienen respuesta). Lee el cuerpo como JSON suelto o como
// flujo SSE hasta dar con el evento que lleva la `id`, y cierra.
struct Posted {
    status: int,
    headers: Map<string, string>,
    result: Result<Json, string>,
}

fn post(
    s: Server,
    session_id: string,
    line: string,
    id: int,
    timeout_ms: int
) -> Result<Posted, string> {
    let stream = match (http.stream_with(
        "POST",
        s.url,
        line.to_bytes(),
        http_headers(s, session_id),
        timeout_ms
    )) {
        Result.Ok(st) => st,
        Result.Err(e) => {
            return Result.Err("cannot reach ${s.url}: ${e}");
        },
    };
    let status = stream.status;
    let headers = stream.headers;
    let kind = header_of(headers, "content-type").to_lower();
    var acc: bytes = b"";
    var outcome: Result<Json, string> = Result.Err("the stream ended without a reply to id ${id}");
    if (status == 202 || status == 204 || id < 0) {
        // Una notificación aceptada, o una respuesta sin cuerpo que interese.
        http.stream_close(stream);
        return Result.Ok(
            Posted { status: status, headers: headers, result: Result.Ok(Json.JNull) }
        );
    }
    var reading = true;
    while (reading) {
        match (http.stream_read(stream)) {
            Result.Err(e) => {
                outcome = Result.Err("reading the reply failed: ${e}");
                reading = false;
            },
            Result.Ok(chunk) => match (chunk) {
                Option.None => {
                    reading = false;
                },
                Option.Some(part) => {
                    acc = acc + part;
                    if (kind.contains("text/event-stream")) {
                        // Un evento por vez; el que lleve la `id` es la respuesta.
                        var decoding = true;
                        while (decoding && reading) {
                            match (sse.decode(acc)) {
                                Option.None => {
                                    decoding = false;
                                },
                                Option.Some(decoded) => {
                                    acc = acc.sub_bytes(decoded.1, acc.len());
                                    match (reply_with_id(decoded.0.data, id)) {
                                        Option.Some(found) => {
                                            outcome = found;
                                            reading = false;
                                        },
                                        Option.None => { },
                                    }
                                },
                            }
                        }
                    }
                    if (acc.len() > MAX_STREAM_BYTES) {
                        outcome = Result.Err("the reply exceeds ${MAX_STREAM_BYTES} bytes");
                        reading = false;
                    }
                },
            },
        }
    }
    http.stream_close(stream);
    if (status < 200 || status >= 300) {
        let body = match (from_utf8(acc)) {
            Result.Ok(t) => ui.clip(t.trim(), MAX_ERROR_BODY),
            Result.Err(_) => "",
        };
        let detail = if (body == "") { "" } else { ": ${body}" };
        return Result.Ok(
            Posted {
                status: status,
                headers: headers,
                result: Result.Err("HTTP ${status}${detail}")
            }
        );
    }
    if (!kind.contains("text/event-stream")) {
        outcome = match (from_utf8(
            acc
        )) {
            Result.Err(_) => Result.Err("the reply is not UTF-8"),
            Result.Ok(text) => match (reply_with_id(text, id)) {
                Option.Some(found) => found,
                Option.None => Result.Err(
                    "the reply does not answer id ${id}: ${ui.clip(text.trim(), MAX_ERROR_BODY)}"
                ),
            },
        };
    }
    Result.Ok(Posted { status: status, headers: headers, result: outcome })
}

// `initialize` + `initialized` por HTTP; se queda con la sesión y las instrucciones.
fn connect_http(s: Server, timeout_ms: int) -> Result<Web, string> {
    let lines = handshake().trim().split("\n");
    let posted = post(s, "", lines[0], HELLO_ID, timeout_ms)?;
    let result = match (posted.result) {
        Result.Ok(r) => r,
        Result.Err(e) => {
            return Result.Err("initialize failed: ${e}");
        },
    };
    let web = Web { session_id: header_of(
        posted.headers,
        "mcp-session-id"
    ), next_id: HELLO_ID + 1, instructions: match (json.get_string(result, "instructions")) {
        Option.Some(text) => text.trim(),
        Option.None => "",
    } };
    // La notificación no tiene respuesta: un 202 (o cualquier 2xx) basta.
    match (post(s, web.session_id, lines[1], 0 - 1, timeout_ms)) {
        Result.Ok(_) => { },
        Result.Err(e) => {
            return Result.Err("initialized notification failed: ${e}");
        },
    }
    Result.Ok(web)
}

// Una petición sobre la sesión HTTP. `Err` con `expired` = true si el servidor ya no
// reconoce la sesión (404): el actor la reabre y reintenta una vez.
fn exchange_http(
    s: Server,
    web: Web,
    method: string,
    params: Json,
    timeout_ms: int
) -> Result<Answer, string> {
    let id = web.next_id;
    web.next_id = web.next_id + 1;
    let posted = post(s, web.session_id, request(id, method, params), id, timeout_ms)?;
    if (posted.status == 404 && web.session_id != "") {
        return Result.Err(SESSION_EXPIRED);
    }
    let result = posted.result?;
    Result.Ok(Answer { result: result, instructions: web.instructions })
}

const SESSION_EXPIRED: string = "the server no longer knows this session";

// Cierra la sesión HTTP: un DELETE con su id, que el servidor puede no admitir.
fn disconnect_http(s: Server, web: Web) {
    if (web.session_id == "") {
        return;
    }
    match (http.request_bytes(
    "DELETE",
    s.url,
    b"",
    http_headers(s, web.session_id),
    STOP_GRACE_MS
)) {
        Result.Ok(_) => { },
        Result.Err(_) => { },
    }
}

// El actor HTTP: igual que el de stdio, pero lo que posee es una sesión, no un proceso.
fn serve_http(s: Server) {
    var web: Option<Web> = Option.None;
    var serving = true;
    while (serving) {
        match (recv(s.link)) {
            Option.None => {
                serving = false;
            },
            Option.Some(req) => match (req) {
                Request.Stop(ack) => {
                    match (web) {
                        Option.Some(w) => disconnect_http(s, w),
                        Option.None => { },
                    }
                    web = Option.None;
                    serving = false;
                    send(ack, 1);
                },
                Request.Ask(method, params, timeout_ms, reply) => {
                    var attempts = 0;
                    var outcome: Result<Answer, string> = Result.Err("not attempted");
                    var retrying = true;
                    while (retrying && attempts < 2) {
                        attempts = attempts + 1;
                        let ready: Result<Web, string> = match (web) {
                            Option.Some(w) => Result.Ok(w),
                            Option.None => connect_http(s, timeout_ms),
                        };
                        match (ready) {
                            Result.Err(e) => {
                                outcome = Result.Err(e);
                                retrying = false;
                            },
                            Result.Ok(w) => {
                                web = Option.Some(w);
                                outcome = exchange_http(s, w, method, params, timeout_ms);
                                match (outcome) {
                                    Result.Err(e) => {
                                        if (e == SESSION_EXPIRED) {
                                            web = Option.None;
                                        } else {
                                            retrying = false;
                                        }
                                    },
                                    Result.Ok(_) => {
                                        retrying = false;
                                    },
                                }
                            },
                        }
                    }
                    send(reply, outcome);
                },
            },
        }
    }
}

/// Starts the server's actor (its process is launched on the first request).
pub fn start(s: Server) {
    if (s.running) {
        return;
    }
    s.running = true;
    if (is_http(s)) {
        spawn(fn() {
            serve_http(s);
        });
    } else {
        spawn(fn() {
            serve(s);
        });
    }
}

/// Stops the server's actor and its process, waiting until both are gone.
pub fn stop(s: Server) {
    if (!s.running) {
        return;
    }
    let ack: Channel<int> = Channel.new();
    send(s.link, Request.Stop(ack));
    recv(ack);
    s.running = false;
}

/// Stops every server: what the harness does on the way out.
pub fn shutdown(servers: [Server]) {
    for s in servers {
        stop(s);
    }
}

/// One request to the server, from any fiber: it goes through the actor's channel.
pub fn ask(s: Server, method: string, params: Json, timeout_ms: int) -> Result<Answer, string> {
    if (!s.running) {
        return Result.Err("the MCP server '${s.name}' is not running");
    }
    let reply: Channel<Result<Answer, string>> = Channel.new();
    send(s.link, Request.Ask(method, params, timeout_ms, reply));
    match (recv(reply)) {
        Option.Some(outcome) => outcome,
        Option.None => Result.Err("the MCP server '${s.name}' went away"),
    }
}

/// (Re)starts `s` and asks for its catalogue. On failure the server is stopped and marked
/// unavailable with the reason in `note`; on success `note` is cleared, `tool_count` and
/// `instructions` are set, and the session stays up for the calls to come.
pub fn discover(s: Server, timeout_ms: int) -> Result<[RemoteTool], string> {
    stop(s);
    if (!s.enabled) {
        return Result.Ok([]);
    }
    start(s);
    let outcome: Result<[RemoteTool], string> = match (ask(
        s,
        "tools/list",
        empty_object(),
        timeout_ms
    )) {
        Result.Ok(answer) => {
            s.instructions = answer.instructions;
            parse_tools(answer.result)
        },
        Result.Err(e) => Result.Err(e),
    };
    match (outcome) {
        Result.Ok(tools) => {
            s.note = "";
            s.tool_count = tools.len();
            // Los recursos son opcionales en el protocolo: un servidor sin ellos contesta
            // con un error de método, y eso no es un fallo del servidor.
            s.resources = match (ask(s, "resources/list", empty_object(), timeout_ms)) {
                Result.Ok(answer) => match (parse_resources(answer.result)) {
                    Result.Ok(r) => r,
                    Result.Err(_) => [],
                },
                Result.Err(_) => [],
            };
        },
        Result.Err(e) => {
            stop(s);
            s.enabled = false;
            s.note = e;
            s.tool_count = 0;
            s.instructions = "";
            s.resources = [];
        },
    }
    outcome
}

/// `tools/call` of `tool` (the raw server-side name) with the parsed `arguments`.
pub fn call(s: Server, tool: string, arguments: Json, timeout_ms: int) -> Result<string, string> {
    let params = obj(["name", "arguments"], [jstr(tool), arguments]);
    let answer = ask(s, "tools/call", params, timeout_ms)?;
    flatten(answer.result)
}

/// `resources/read` of `uri`, as text.
pub fn read_resource(s: Server, uri: string, timeout_ms: int) -> Result<string, string> {
    let answer = ask(s, "resources/read", obj(["uri"], [jstr(uri)]), timeout_ms)?;
    flatten_contents(answer.result)
}

/// The server that publishes `uri`, if any.
pub fn publisher(servers: [Server], uri: string) -> Option<Server> {
    for s in servers {
        if (s.enabled) {
            for r in s.resources {
                if (r.uri == uri) {
                    return Option.Some(s);
                }
            }
        }
    }
    Option.None
}

/// Every resource of every enabled server, in configuration order.
pub fn all_resources(servers: [Server]) -> [Resource] {
    var out: [Resource] = [];
    for s in servers {
        if (s.enabled) {
            out = out + s.resources;
        }
    }
    out
}

/// What every enabled server asked to put in the system prompt, one labelled block per
/// server; empty when none declared instructions.
pub fn instructions_of(servers: [Server]) -> string {
    var blocks: [string] = [];
    for s in servers {
        if (s.enabled && s.instructions != "") {
            blocks.push(
                "Instructions from the MCP server '${s.name}' (its tools are prefixed mcp__${s.name}__):\n${s.instructions}"
            );
        }
    }
    blocks.join("\n\n")
}

/// One line describing how the server is launched, for the banner and `/mcp`.
pub fn command_line(s: Server) -> string {
    if (s.url != "") {
        s.url
    } else if (s.args.len() == 0) {
        s.command
    } else {
        s.command + " " + s.args.join(" ")
    }
}

/// True when the server is reached over HTTP rather than a child process.
pub fn is_http(s: Server) -> bool {
    s.url != ""
}
