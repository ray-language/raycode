// El bucle del agente: manda el historial al modelo, ejecuta las herramientas que pida y
// repite hasta que conteste sin pedir ninguna (o hasta agotar `max_steps`).
//
// Cada paso —la petición y cada herramienta— corre en su propia fibra y el turno espera
// por CANAL, no por retorno: así puede dejar de esperar. Una segunda fibra vigila el
// teclado (el terminal está en modo crudo durante todo el turno) y manda "cancelado" si
// llega ESC. Lo que se abandona sigue vivo hasta que termine solo; lo que no se abandona
// es la conversación: las llamadas sin responder se cierran con un resultado sintético
// para que el historial siga siendo válido en el siguiente turno.
from src/config import Config;
import src/config;
from src/message import Message, ToolCall, Reply;
import src/message;
from src/tools import Tool;
import src/tools;
import src/permissions;
import src/modes;
from src/mcp import Server;
import src/mcp;
from src/usage import Usage;
import src/usage;
import src/client;
import src/render;
import src/spinner;
import std/term;
import std/io;
from std/term import Key;
import src/ui;
import std/time;
import std/json;
from std/json import Json;

// Cada cuánto se mira el teclado mientras se espera.
const POLL_MS: int = 60;

const EVENT_DONE: int = 0;

const EVENT_CANCELLED: int = 1;

// La tecla que aborta, y el Ctrl-C que en modo crudo llega como octeto en vez de señal.
const KEY_ESCAPE: int = 27;

const KEY_INTERRUPT: int = 3;

/// A live conversation: its configuration, its tools, the transcript, and what it has
/// cost so far.
pub struct Session {
    config: Config,
    tools: [Tool],
    mcp: [Server],
    history: [Message],
    total: Usage,
    turns: int,
    steps: int,
    /// Keys typed while the turn was running, for the line editor to pick up.
    typeahead: bytes,
}

/// The catalogue as this session's mode sees it. The full one is kept — a mode is changed
/// mid-conversation and the tools have to come back — and this is what the model is shown
/// and what a call is checked against.
pub fn offered(s: Session) -> [Tool] {
    tools.for_mode(s.tools, modes.find(s.config.mode).writes)
}

// Lo que sale de un paso: hay respuesta, falló, o el usuario lo paró.
enum Step {
    Ready(Reply),
    Failed(string),
    Cancelled,
}

/// An empty session for `c`, with the tool registry its configuration allows and the
/// tools of every configured MCP server. Only an unusable `mcp.json` is an error: a
/// server that fails to answer is marked and skipped.
pub fn open(c: Config) -> Result<Session, string> {
    let empty: [Message] = [];
    let servers: [Server] = if (c.mcp_enabled) { mcp.load(c.mcp_config)? } else { [] };
    let s = Session {
        config: c,
        tools: [],
        mcp: servers,
        history: empty,
        total: usage.zero(),
        turns: 0,
        steps: 0,
        typeahead: b""
    };
    reconnect(s);
    Result.Ok(s)
}

/// Stops every MCP server. The harness calls it on the way out; a server left running
/// would only see EOF on its stdin when the process dies.
pub fn close(s: Session) {
    mcp.shutdown(s.mcp);
}

/// Rebuilds the catalogue: the builtins plus a fresh discovery against every MCP server
/// (a server that had failed gets another chance; a healthy one is restarted). The
/// transcript is kept.
pub fn reconnect(s: Session) {
    for server in s.mcp {
        // Un servidor apagado por configuración sigue apagado; uno caído se reintenta.
        if (!server.enabled && server.note != "disabled in the configuration") {
            server.enabled = true;
        }
    }
    s.tools = tools.registry(s.config.allow_exec) + tools.from_servers(s.mcp);
    s.config.mcp_instructions = mcp.instructions_of(s.mcp);
}

/// Forgets the transcript (the configuration and the accumulated usage stay).
pub fn reset(s: Session) {
    let empty: [Message] = [];
    s.history = empty;
    // Conversación nueva, id nuevo: el proxy no debe enlazarla con la anterior.
    config.new_session(s.config);
}

// En modo crudo el terminal no traduce NINGÚN salto de línea: hay que devolver el carro a
// mano, y también en los saltos de DENTRO del texto (la salida de una herramienta llega
// en un solo bloque de varias líneas). Si no, cada línea empieza donde acabó la anterior
// y el bloque sale en escalera.
fn say(text: string, raw: bool) {
    if (raw) {
        ui.write_inline(ui.crlf(text));
    } else {
        print(text);
    }
}

// ¿Pide el usuario parar? ESC a secas o Ctrl-C. Una flecha TAMBIÉN empieza por ESC, así
// que el trozo se decodifica en vez de mirar el octeto: `term.decode` distingue la tecla
// Esc de una secuencia CSI. Un ESC suelto queda como prefijo incompleto — y suelto, en un
// trozo que ya llegó entero, es exactamente la tecla Esc.
fn cancels(chunk: bytes) -> bool {
    match (term.decode(chunk)) {
        Option.Some(decoded) => match (decoded.0) {
            Key.Esc => true,
            Key.Ctrl(c) => c == 'c',
            _ => false,
        },
        Option.None => chunk == b"\x1b",
    }
}

// Vigila el teclado mientras otra fibra trabaja. El sondeo es puro (plazo 0: no aparca) y
// el pulso lo pone una fibra que duerme, para poder atender también la orden de parar:
// `select` sobre [parar, pulso].
fn watch_keys(events: Channel<Signal>, stop: Channel<int>) {
    var watching = true;
    while (watching) {
        let tick: Channel<int> = Channel.new();
        spawn(fn() {
            time.sleep(POLL_MS);
            send(tick, 1);
        });
        if (select([stop, tick]) == 0) {
            watching = false;
        } else {
            match (io.read_timeout(64, 0)) {
                io.ReadResult.Data(chunk) => {
                    if (cancels(chunk)) {
                        send(events, Signal.Cancelled);
                        watching = false;
                    } else {
                        // Lo que no es parar se guarda: es el principio de la siguiente línea.
                        send(events, Signal.Typed(chunk));
                    }
                },
                io.ReadResult.Eof => {
                    watching = false;
                },
                io.ReadResult.TimedOut => { },
            }
        }
    }
}

// ¿Terminó el trabajo, o el usuario pulsó ESC? Devuelve true si hay que cancelar. Lo
// tecleado entre medias se guarda en la sesión.
fn wait_for(s: Session, signals: Channel<Signal>, stop: Channel<int>) -> bool {
    var cancelled = false;
    var waiting = true;
    while (waiting) {
        match (recv(signals)) {
            Option.None => {
                waiting = false;
            },
            Option.Some(what) => match (what) {
                Signal.Cancelled => {
                    cancelled = true;
                    waiting = false;
                },
                Signal.Done => {
                    waiting = false;
                },
                Signal.Typed(keys) => {
                    s.typeahead = s.typeahead + keys;
                },
                Signal.Text(_) => { },
            },
        }
    }
    // El vigilante se retira: su fibra no debe sobrevivir al paso que vigilaba.
    send(stop, 1);
    cancelled
}

// Lo que la fibra trabajadora le cuenta al turno mientras trabaja.
enum Signal {
    Text(string),
    Typed(bytes),
    Done,
    Cancelled,
}

// Una petición al modelo, cancelable. La fibra trabajadora recibe una copia de la sesión
// (los heaps de las fibras son independientes), así que solo lee: no muta nada.
//
// El texto que llega se PINTA EN ESTA FIBRA, no en la trabajadora: así, al cancelar, deja
// de pintarse en el acto — una fibra abandonada seguiría escribiendo sobre el prompt.
fn call_model(s: Session, label: string, width: int, raw: bool, watch: bool) -> Step {
    let signals: Channel<Signal> = Channel.new();
    let stop: Channel<int> = Channel.new();
    let box: Channel<Result<Reply, string>> = Channel.new();
    let streaming = s.config.stream;
    spawn(fn() {
        // Bajo `try_call`: si la fibra trabajadora muriera de un panic, nadie avisaría al
        // canal y el turno esperaría para siempre. Un fallo tiene que ser un valor.
        let guarded = try_call(fn() -> Result<Reply, string> {
            if (streaming) {
                client.send_stream(s.config, offered(s), s.history, fn(piece: string) {
                    send(signals, Signal.Text(piece));
                })
            } else {
                client.send(s.config, offered(s), s.history)
            }
        });
        let outcome: Result<Reply, string> = match (guarded) {
            Result.Ok(sent) => sent,
            Result.Err(e) => Result.Err("the request failed: ${e}"),
        };
        send(box, outcome);
        send(signals, Signal.Done);
    });
    if (watch) {
        spawn(fn() {
            watch_keys(signals, stop);
        });
    }
    let waiting = spinner.start(label);
    var spinning = true;
    var cancelled = false;
    let brush = painter(width, raw);
    var listening = true;
    while (listening) {
        match (recv(signals)) {
            Option.None => {
                listening = false;
            },
            Option.Some(signal) => match (signal) {
                Signal.Text(piece) => {
                    // El indicador dura hasta el primer token: a partir de ahí manda el texto.
                    if (spinning) {
                        spinner.stop_it(waiting);
                        spinning = false;
                    }
                    feed(brush, piece);
                },
                Signal.Typed(keys) => {
                    s.typeahead = s.typeahead + keys;
                },
                Signal.Done => {
                    listening = false;
                },
                Signal.Cancelled => {
                    cancelled = true;
                    listening = false;
                },
            },
        }
    }
    // El vigilante se retira: su fibra no debe sobrevivir al paso que vigilaba.
    send(stop, 1);
    if (spinning) {
        spinner.stop_it(waiting);
    }
    if (cancelled) {
        return Step.Cancelled;
    }
    flush(brush);
    match (recv(box)) {
        Option.None => Step.Failed("the request fiber produced nothing"),
        Option.Some(outcome) => match (outcome) {
            Result.Ok(reply) => Step.Ready(reply),
            Result.Err(e) => Step.Failed(e),
        },
    }
}

// Una herramienta, cancelable igual. `None` = el usuario paró la espera.
fn call_tool(s: Session, call: ToolCall, watch: bool) -> Option<string> {
    let signals: Channel<Signal> = Channel.new();
    let stop: Channel<int> = Channel.new();
    let box: Channel<string> = Channel.new();
    spawn(fn() {
        let guarded = try_call(fn() -> string {
            tools.execute(offered(s), s.mcp, call.name, call.arguments)
        });
        let result = match (guarded) {
            Result.Ok(text) => text,
            Result.Err(e) => "error: the tool fiber failed (${e})",
        };
        send(box, result);
        send(signals, Signal.Done);
    });
    if (watch) {
        spawn(fn() {
            watch_keys(signals, stop);
        });
    }
    let running = spinner.start(hint("running ${call.name}", watch));
    let cancelled = wait_for(s, signals, stop);
    spinner.stop_it(running);
    if (cancelled) {
        return Option.None;
    }
    recv(box)
}

// ------------------------------------------------------------- el consentimiento

// El mandato que una llamada va a correr, o "" si no es esa clase de llamada. Se mira el
// argumento porque el permiso se da sobre el PROGRAMA, no sobre la herramienta: prestar
// `run_command` entero no es prestar nada, es abrirlo todo.
fn command_of(call: ToolCall) -> string {
    if (call.name != "run_command") {
        return "";
    }
    match (json.parse(call.arguments.trim())) {
        Result.Ok(j) => match (json.get_string(j, "command")) {
            Option.Some(c) => c,
            Option.None => "",
        },
        Result.Err(_) => "",
    }
}

// ¿Puede correr esta llamada? "" = adelante; cualquier otra cosa es lo que se le contesta
// al modelo en lugar de ejecutarla.
//
// El orden importa: primero lo que el nivel deja pasar solo, luego lo que el usuario ya
// prestó en esta sesión, y solo entonces se le pregunta. Sin terminal no se pregunta: no
// hay a quién, y una espera en un guion es un cuelgue.
fn consent_for(s: Session, call: ToolCall, raw: bool) -> string {
    let risk = tools.risk_of(s.tools, call.name);
    if (permissions.unattended(s.config.autonomy, risk)) {
        return "";
    }
    if (s.config.allowed_tools.contains(call.name)) {
        return "";
    }
    let command = command_of(call);
    if (command != "" && permissions.allowed(s.config.allowed_programs, command)) {
        return "";
    }
    if (!raw) {
        return "not run: raycode is not interactive here, so nobody could be asked. The user "
            + "can allow it with --autonomy auto, or lend the program with --allow.";
    }
    ask_user(s, call, command)
}

// La pregunta, y lo que se hace con la respuesta. Una tecla, sin Enter: el terminal ya está
// en modo crudo y la llamada ya se ha enseñado encima.
fn ask_user(s: Session, call: ToolCall, command: string) -> string {
    let program = permissions.program_of(command);
    // «Siempre» presta el programa cuando el mandato es UNO; con una tubería dentro, lo que
    // se preste no sería lo que se está viendo, así que solo se ofrece el sí de esta vez.
    let lendable = if (command == "") {
        call.name
    } else if (permissions.is_simple(command) && program != "") {
        program
    } else {
        ""
    };
    let always = if (lendable == "") { "" } else { " · ${ui.bold("a")} always (${lendable})" };
    ui.write_inline(
        ui.crlf(
            ui.yellow("? ")
                + "allow this? "
                + ui.bold("y")
                + " yes"
                + always
                + " · "
                + ui.bold("n")
                + " no"
        )
    );
    let key = read_key();
    if (key == "y" || key == "Y" || key == "\r" || key == "\n") {
        return "";
    }
    if (lendable != "" && (key == "a" || key == "A")) {
        if (command == "") {
            s.config.allowed_tools.push(lendable);
        } else {
            s.config.allowed_programs.push(lendable);
        }
        ui.write_inline(ui.crlf(ui.dim("  ${lendable} is allowed for the rest of this session")));
        return "";
    }
    "the user did not allow this call. Do not try it again; say what you needed it for."
}

// Una tecla, esperando lo que haga falta. El vigilante de teclas no corre en este momento
// —vive dentro de cada paso, no entre ellos—, así que aquí no hay quien compita por la
// entrada. Se sondea en tramos para que un EOF no se quede colgado.
fn read_key() -> string {
    var waiting = true;
    var key = "";
    while (waiting) {
        match (io.read_timeout(64, 60000)) {
            io.ReadResult.Data(chunk) => {
                // El primer octeto del trozo: una flecha llega como varios y no es
                // ninguna de las respuestas, así que basta con mirar por dónde empieza.
                key = if (chunk.len() > 0) {
                    from_utf8(chunk.sub_bytes(0, 1)).unwrap_or("")
                } else {
                    ""
                };
                waiting = false;
            },
            io.ReadResult.Eof => {
                waiting = false;
            },
            io.ReadResult.TimedOut => { },
        }
    }
    key
}

// La etiqueta del indicador, con el recordatorio de que se puede parar.
fn hint(label: string, watch: bool) -> string {
    if (watch) { "${label} · esc to stop" } else { label }
}

// El pintor de una respuesta que llega por trozos. El Markdown no se puede renderizar a
// medias —una lista o una cerca de código no significan nada hasta que cierran—, así que
// se acumula y se vuelca por BLOQUES: en cuanto hay una línea en blanco fuera de una
// cerca, ese trozo ya es un documento completo y se pinta.
struct Painter {
    buffer: string,
    scanned: int,
    fences: int,
    width: int,
    raw: bool,
    started: bool,
}

fn painter(width: int, raw: bool) -> Painter {
    Painter { buffer: "", scanned: 0, fences: 0, width: width, raw: raw, started: false }
}

// Recorre SOLO lo que aún no se había mirado: así el coste es lineal aunque la respuesta
// sea larga. Devuelve el corte (0 = todavía no hay bloque cerrado).
fn feed(p: Painter, piece: string) {
    p.buffer = p.buffer + piece;
    var cut = 0;
    var i = p.scanned;
    while (i + 1 < p.buffer.len()) {
        if (p.buffer.substring(i, i + 3) == "```") {
            p.fences = p.fences + 1;
        }
        if (p.buffer.substring(i, i + 2) == "\n\n" && p.fences - p.fences / 2 * 2 == 0) {
            cut = i + 2;
        }
        i = i + 1;
    }
    p.scanned = if (p.buffer.len() > 1) { p.buffer.len() - 1 } else { 0 };
    if (cut > 0) {
        let ready = p.buffer.substring(0, cut);
        p.buffer = p.buffer.substring(cut, p.buffer.len());
        p.scanned = 0;
        p.fences = 0;
        paint(p, ready);
    }
}

// Lo que quede al terminar el flujo.
fn flush(p: Painter) {
    if (p.buffer.trim() != "") {
        paint(p, p.buffer);
    }
    p.buffer = "";
    p.scanned = 0;
    p.fences = 0;
}

// Un bloque ya cerrado, pintado bajo la viñeta (solo el primero la lleva).
fn paint(p: Painter, text: string) {
    // El ancho se vuelve a medir por bloque: si la ventana cambia a mitad de respuesta, lo
    // que quede por pintar sale ya al tamaño nuevo.
    let body = render.markdown_text(text.trim(), ui.width() - 2);
    for line in body.split("\n") {
        if (!p.started) {
            say(ui.cyan("⏺ ") + line, p.raw);
            p.started = true;
        } else if (line == "") {
            say("", p.raw);
        } else {
            say("  " + line, p.raw);
        }
    }
    say("", p.raw);
}

// Cuántas líneas de un argumento largo se enseñan antes de resumir el resto.
const PREVIEW_LINES: int = 8;

// A partir de cuántos caracteres un argumento deja de caber en la cabecera.
const INLINE_MAX: int = 72;

// El valor tal como cabe en la cabecera, o `None` si es largo o tiene saltos: eso baja
// abajo como código.
fn inline_value(v: Json) -> Option<string> {
    let text = match (v) {
        Json.JStr(s) => s,
        Json.JNull => "null",
        Json.JBool(b) => if (b) { "true" } else { "false" },
        _ => json.stringify(v),
    };
    if (text.contains("\n") || text.len() > INLINE_MAX) {
        Option.None
    } else {
        Option.Some(text)
    }
}

// Un argumento largo, convertido en las líneas del código que es (nunca en el JSON
// escapado que viajó por el cable): unas cuantas y cuántas quedan.
fn block_lines(key: string, value: string) -> [string] {
    var body = value;
    while (body.ends_with("\n")) {
        body = body.substring(0, body.len() - 1);
    }
    let lines = body.split("\n");
    let width = ui.width() - 6;
    var out: [string] = ["  " + key + " · " + plural(lines.len(), "line")];
    var i = 0;
    while (i < lines.len() && i < PREVIEW_LINES) {
        out.push("  │ " + ui.clip(lines[i], width));
        i = i + 1;
    }
    if (lines.len() > PREVIEW_LINES) {
        out.push("  │ … " + plural(lines.len() - PREVIEW_LINES, "more line"));
    }
    out
}

// "1 line" / "3 lines": el resumen se lee mejor sin el "(s)".
fn plural(n: int, noun: string) -> string {
    if (n == 1) { "${n} ${noun}" } else { "${n} ${noun}s" }
}

/// How a tool call reads on screen, without any colour: the first line is the tool and its
/// short arguments, and every long one — the contents of a file, a patch — follows as the
/// code it is. Arguments that are not a JSON object (a model may send anything) stay as
/// they came, clipped.
pub fn call_summary(name: string, arguments: string) -> [string] {
    let fields = match (json.parse(arguments.trim())) {
        Result.Ok(j) => json.as_object(j),
        Result.Err(_) => Option.None,
    };
    match (fields) {
        Option.None => [name + " " + ui.clip(arguments.trim(), 160)],
        Option.Some(table) => {
            var inline: [string] = [];
            var blocks: [string] = [];
            for key in table.keys().sort() {
                match (table.get(key)) {
                    Option.Some(v) => match (inline_value(v)) {
                        Option.Some(text) => {
                            inline.push(key + ": " + text);
                        },
                        Option.None => {
                            blocks.push(key);
                        },
                    },
                    Option.None => { },
                }
            }
            let summary = if (inline.len() == 0) { "" } else { " " + inline.join("  ") };
            var out: [string] = [name + ui.clip(summary, ui.width() - name.len() - 4)];
            for key in blocks {
                match (table.get(key)) {
                    Option.Some(v) => {
                        let text = match (json.as_string(v)) {
                            Option.Some(str) => str,
                            Option.None => json.stringify_pretty(v, 2),
                        };
                        for line in block_lines(key, text) {
                            out.push(line);
                        }
                    },
                    Option.None => { },
                }
            }
            out
        },
    }
}

// La llamada en pantalla: la cabecera con su viñeta y el resto en gris, como el resultado.
fn show_call(name: string, arguments: string, raw: bool) {
    let lines = call_summary(name, arguments);
    let head = lines[0];
    let cut = name.len();
    say(ui.yellow("⚙ ") + ui.bold(name) + ui.dim(head.substring(cut, head.len())), raw);
    var i = 1;
    while (i < lines.len()) {
        say(ui.dim(lines[i]), raw);
        i = i + 1;
    }
}

// El resultado, sangrado y recortado: el modelo lo ve entero, el usuario un resumen.
fn show_result(text: string, raw: bool) {
    say(ui.dim(ui.indent(ui.clip(text.trim(), 400), "  │ ")), raw);
}

// La respuesta del modelo, con su Markdown pintado y sangrada bajo la viñeta.
fn show_answer(text: string, width: int, raw: bool) {
    var first = true;
    for line in render.markdown_text(text, width - 2).split("\n") {
        if (first) {
            say(ui.cyan("⏺ ") + line, raw);
            first = false;
        } else if (line == "") {
            say("", raw);
        } else {
            say("  " + line, raw);
        }
    }
}

// Cierra las llamadas que quedaron sin responder. Un `tool_use` sin su `tool_result`
// invalida el historial para el siguiente turno (Anthropic lo rechaza), y además el
// modelo merece enterarse de que le pararon.
fn close_pending(s: Session, calls: [ToolCall], start: int) {
    var i = start;
    while (i < calls.len()) {
        s.history.push(message.tool_result(calls[i].id, "stopped by the user"));
        i = i + 1;
    }
}

// El bucle en sí. Va aparte de `ask` para que el modo crudo se restaure en un solo sitio,
// pase lo que pase aquí dentro.
fn run_turn(s: Session, width: int, raw: bool) -> Result<Usage, string> {
    var turn = usage.zero();
    var step = 0;
    var limit = s.config.max_steps;
    while (step < limit) {
        step = step + 1;
        s.steps = s.steps + 1;
        let label = if (step == 1) { "thinking" } else { "thinking · step ${step}" };
        match (call_model(s, hint(label, raw), width, raw, raw)) {
            Step.Cancelled => {
                say(ui.yellow("■ ") + ui.dim("stopped by the user"), raw);
                say("", raw);
                return Result.Ok(turn);
            },
            Step.Failed(e) => {
                // Una queja del proveedor sobre un PARÁMETRO se arregla aquí, en la fibra
                // que tiene la configuración de verdad, y el paso se rehace. Hacerlo dentro
                // de la petición no serviría: allí la sesión es una copia, y el arreglo se
                // perdería con la fibra — que es justo lo que pasaba, una vez por petición.
                let fixed = client.adapt_to(s.config, e);
                if (fixed == "") {
                    return Result.Err(e);
                }
                say(ui.dim("· ${fixed}"), raw);
                step = step - 1;
                s.steps = s.steps - 1;
                continue;
            },
            Step.Ready(reply) => {
                turn = usage.add(turn, reply.usage);
                s.total = usage.add(s.total, reply.usage);
                s.history.push(reply.message);
                let calls = reply.message.tool_calls;
                // Con streaming la respuesta ya se pintó mientras llegaba.
                if (!s.config.stream && reply.message.text.trim() != "") {
                    show_answer(reply.message.text.trim(), width, raw);
                    say("", raw);
                }
                if (message.was_truncated(reply.stop_reason)) {
                    // El modelo no terminó: se quedó sin cupo. Decirlo importa, porque la
                    // respuesta parece completa hasta que se lee el final.
                    say(
                        ui.yellow("! ") + "the answer hit the ${s.config.max_tokens}-token ceiling; raise it with /set max-tokens N",
                        raw
                    );
                    say("", raw);
                }
                if (calls.len() == 0) {
                    return Result.Ok(turn);
                }
                var i = 0;
                while (i < calls.len()) {
                    let call = calls[i];
                    show_call(call.name, call.arguments, raw);
                    // Nada que cambie el proyecto corre sin el sí que pida el nivel. Un no
                    // no rompe la conversación: se contesta a la llamada y el turno sigue,
                    // porque un `tool_use` sin su resultado invalida el historial.
                    let refusal = consent_for(s, call, raw);
                    if (refusal != "") {
                        say(ui.yellow("■ ") + ui.dim(refusal), raw);
                        say("", raw);
                        s.history.push(message.tool_result(call.id, refusal));
                    } else {
                        match (call_tool(s, call, raw)) {
                            Option.None => {
                                close_pending(s, calls, i);
                                say(ui.yellow("■ ") + ui.dim("stopped by the user"), raw);
                                say("", raw);
                                return Result.Ok(turn);
                            },
                            Option.Some(result) => {
                                show_result(result, raw);
                                say("", raw);
                                s.history.push(message.tool_result(call.id, result));
                            },
                        }
                    }
                    i = i + 1;
                }
            },
        }
        // El tope de pasos es un freno para un modelo que da vueltas, no un final: con un
        // terminal delante se pregunta antes de parar.
        if (step >= limit && raw && wants_more(limit, s.config.max_steps)) {
            limit = limit + s.config.max_steps;
        }
    }
    say(ui.red("! ") + "stopped after ${limit} tool steps (raise --max-steps)", raw);
    Result.Ok(turn)
}

// La pregunta al llegar al tope: una tecla, con plazo. Solo en modo crudo interactivo.
fn wants_more(reached: int, extra: int) -> bool {
    ui.write_inline(
        ui.crlf(
            ui.yellow("? ") + "${reached} tool steps so far · press c to allow ${extra} more, any other key to stop"
        )
    );
    match (io.read_timeout(64, 60000)) {
        io.ReadResult.Data(chunk) => chunk == b"c" || chunk == b"C",
        io.ReadResult.TimedOut => false,
        io.ReadResult.Eof => false,
    }
}

/// Runs one user turn to completion: the model may call tools any number of times (up to
/// `max_steps`), every intermediate step is shown as it happens, and ESC stops the turn
/// wherever it is. Returns what the turn consumed; the session's running total is updated
/// too.
pub fn ask(s: Session, prompt: string) -> Result<Usage, string> {
    s.history.push(message.user(prompt));
    s.turns = s.turns + 1;
    // El ancho de referencia del turno (`term.size` es un ioctl: cada bloque lo re-mide
    // barato, y este solo sirve de base para lo que no se pinta por bloques).
    let width = ui.width();
    // Aire entre lo que acaba de escribir el usuario y lo que va a contestar el modelo.
    print("");
    if (!ui.interactive()) {
        return run_turn(s, width, false);
    }
    // El modo crudo dura todo el turno: es lo que hace que el ESC llegue en el momento, en
    // vez de quedarse en el búfer de línea hasta el siguiente Enter. `term.raw` lo restaura
    // pase lo que pase dentro —incluido un panic— y también al salir el proceso.
    match (term.raw(fn() -> Result<Usage, string> {
        run_turn(s, width, true)
    })) {
        Result.Ok(outcome) => outcome,
        Result.Err(e) => Result.Err("the turn failed: ${e}"),
    }
}
